BACKSTAGE_SOURCE=fixture
BACKSTAGE_PAGE_MODE=headless
# Set to restaurant for the standard restaurant recipe and Backstage-managed design.
BACKSTAGE_SITE_PROFILE=
BACKSTAGE_FORM_SUBMISSIONS_ENABLED=false
# Opt in after reviewing this site's saved redirects. Only used with BACKSTAGE_SOURCE=api.
BACKSTAGE_REDIRECTS_ENABLED=false
BACKSTAGE_API_URL=https://bckstg.app/api
BACKSTAGE_API_KEY=
BACKSTAGE_ACCOUNT_ID=
BACKSTAGE_NAVIGATION_ID=
SITE_URL=
SITE_INDEXABLE=false
# Optional GA4 Measurement ID override. Otherwise use the ID saved in Backstage.
GOOGLE_ANALYTICS_ID=
# Standard is the default. Use prominent for marks that need more room.
SITE_HEADER_LOGO_SIZE=standard
# Set to false to omit descriptions from location directory and visit-panel cards.
SITE_LOCATION_CARD_DESCRIPTIONS=true
