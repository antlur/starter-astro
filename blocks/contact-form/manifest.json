{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:contact-form@1",
  "name": "Contact Form",
  "slug": "contact-form",
  "description": "Render an existing Backstage form with its configured fields and submission settings.",
  "schema": {
    "fields": [
      {
        "name": "Eyebrow",
        "slug": "eyebrow",
        "type": "text",
        "order": 0
      },
      {
        "name": "Heading",
        "slug": "heading",
        "type": "text",
        "order": 1
      },
      {
        "name": "Body",
        "slug": "body",
        "type": "rich_text",
        "order": 2
      },
      {
        "name": "Form",
        "slug": "form_id",
        "type": "form_select",
        "order": 3
      },
      {
        "name": "Submit label",
        "slug": "submit_label",
        "type": "text",
        "order": 4
      }
    ]
  }
}
