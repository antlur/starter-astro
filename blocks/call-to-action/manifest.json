{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:call-to-action@1",
  "name": "Call to Action",
  "slug": "call-to-action",
  "description": "A focused section that pairs short supporting copy with one prominent link.",
  "schema": {
    "fields": [
      { "name": "Eyebrow", "slug": "eyebrow", "type": "text", "order": 0 },
