      { "name": "Body", "slug": "body", "type": "rich_text", "order": 2 },
      { "name": "Button label", "slug": "button_label", "type": "text", "required": true, "order": 3 },
      { "name": "Button URL", "slug": "button_url", "type": "url", "required": true, "order": 4 }
    ]
  }
}
