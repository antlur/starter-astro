---
import "../styles/global.css";
import LocationDirectoryPage from "../components/LocationDirectoryPage.astro";
import LocationHoursSection from "../components/LocationHoursSection.astro";
import SiteAlerts from "../components/SiteAlerts.astro";
import SocialLinks from "../components/SocialLinks.astro";
import NavigationTree from "../components/NavigationTree.astro";
import { alertsForPath } from "../lib/backstage/alerts";
import { getHomePage, getSiteContent, jsonLdForPage, serializeJsonLd } from "../lib/backstage/content";
import { isPublicLocation } from "../lib/backstage/locations";
import { resolveSeoMetadata } from "../lib/seo-metadata";
import { phoneLabel } from "../lib/phone-label";
import { safeImageUrl } from "../lib/safe-url";
import type { HeadlessPage, HeadlessWebsite, SiteNavigationItem } from "../lib/backstage/content";
import type { SiteLocation } from "../lib/backstage/locations";
import { getSiteBuild } from "../site/build";

interface Props {
  page?: HeadlessPage;
  pageTitle?: string | null;
  pageDescription?: string | null;
  pageImage?: string | null;
  contentType?: "website" | "article";
  site: HeadlessWebsite;
  pathname: string;
  navigation: SiteNavigationItem[];
  footerNavigation?: SiteNavigationItem[];
  routePaths: string[];
  alerts: import("@antlur/backstage").Alert[];
  locations: SiteLocation[];
  currentLocation?: SiteLocation;
  locationDirectoryPath?: string;
  showLocationHours?: boolean;
  generatedLocationPage?: boolean;
  locationScopedMenu?: boolean;
  notFound?: boolean;
  menuSectionPaths?: string[];
}

const { page, pageTitle: routeTitle, pageDescription: routeDescription, pageImage, contentType = "website", site, pathname, navigation, footerNavigation = [], routePaths, alerts, locations, currentLocation, locationDirectoryPath, showLocationHours = true, generatedLocationPage = false, locationScopedMenu = false, notFound = false, menuSectionPaths = [] } = Astro.props;
const { structuredData, pages } = await getSiteContent();
const { routePlan } = await getSiteBuild();
const locationRoutes = routePlan.locationRoutes.filter(({ location }) => isPublicLocation(location));
const siteTitle = site.meta?.title || site.name;
const { title, description, openGraphTitle, openGraphDescription } = resolveSeoMetadata({ page, routeTitle, routeDescription, site });
const homeImage = getHomePage(pages).blocks.filter(({ type }) => type === "hero")
  .flatMap(({ fields }) => [fields.image].flat()).map(safeImageUrl).find(Boolean);
const shareImage = !notFound && (pageImage || site.openGraph?.image || homeImage);
const openGraphImage = shareImage && (Astro.site ? new URL(shareImage, Astro.site).href : shareImage);
const canonicalUrl = !notFound && Astro.site ? new URL(pathname, Astro.site).href : undefined;
const indexable = !notFound && import.meta.env.SITE_INDEXABLE === "true" && Boolean(Astro.site);
const themeColor = site.themeVariables?.["--theme-color-header"];
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: Astro.site?.href,
  logo: site.logo?.url,
};
const jsonLd = serializeJsonLd(jsonLdForPage(structuredData, organization));
const contactLocation = currentLocation ?? (locations.length === 1 ? locations[0] : undefined);
const directoryLink = locations.length > 1 ? locationDirectoryPath : undefined;
const primaryAction = navigation.find((item) => item.style === "button");
const topbarCta = site.homeCta && navigation.some((item) => item.style === "button" && item.url === site.homeCta?.url)
  ? null
  : site.homeCta;
const mobileAction = primaryAction
  ? { text: primaryAction.text, url: primaryAction.url, newWindow: primaryAction.newWindow }
  : site.homeCta ? { ...site.homeCta, newWindow: false } : null;
const showTopbar = Boolean(contactLocation?.phone || contactLocation?.addressLines.length || contactLocation?.mapUrl || directoryLink || topbarCta);
const headerLogoSize = site.logo && import.meta.env.SITE_HEADER_LOGO_SIZE === "prominent" ? "prominent" : "standard";
const socialLinks = site.socialLinks;
const visibleAlerts = alertsForPath(alerts, pathname);
const hasPublicLocationRoutes = locationRoutes.length > 0;
const hasLocationsBlock = hasPublicLocationRoutes && (page?.blocks.some(({ type }) => type === "locations") ?? false);
const hasDetailedVisitSection = hasLocationsBlock && (page?.blocks.some(({ type, fields }) => type === "locations" && fields.layout === "visit-panel") ?? false);
const hasAdditionalVisitDetails = locations.some((location) =>
  location.hours.length > 1 || (location.hourGroups?.length ?? 0) > 1 || location.specialHours?.length || location.mapEmbedUrl,
);
const legacyLocationHours = pathname === "/"
  ? locations.length === 1 && !hasDetailedVisitSection && (!hasLocationsBlock || hasAdditionalVisitDetails)
  : showLocationHours && locations.length === 1;
const footerLocations = locationScopedMenu && currentLocation
  ? locationRoutes.filter(({ location }) => location.id === currentLocation.id)
  : locationRoutes;
const showLocationHoursFooter = site.locationHoursFooter === "show"
  && !notFound
  && !generatedLocationPage
  && !hasLocationsBlock
  && footerLocations.length > 0;
const showLegacyLocationHours = site.locationHoursFooter !== "show"
  && site.locationHoursFooter !== "hide"
  && !notFound
  && (pathname === "/" || !hasDetailedVisitSection)
  && legacyLocationHours;
---

<!doctype html>
<html lang="en" style={site.themeVariables && Object.keys(site.themeVariables).length > 0 ? site.themeVariables : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={indexable ? "index,follow" : "noindex,nofollow"} />
    <meta name="description" content={description} />
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <link rel="icon" href={site.faviconUrl || "/favicon.svg"} />
    {site.appleIconUrl && <link rel="apple-touch-icon" href={site.appleIconUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={openGraphTitle} />
    <meta property="og:description" content={openGraphDescription} />
    {openGraphImage && <meta property="og:image" content={openGraphImage} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content={openGraphImage ? "summary_large_image" : "summary"} />
    <title>{title}</title>
    {!notFound && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class:list={["bg-background", "text-foreground", "font-body", mobileAction && "has-mobile-action"]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteAlerts alerts={visibleAlerts} siteDomain={site.domain} routePaths={routePaths} />
    <header class="site-header-shell">
      {showTopbar && (
        <div class="site-topbar">
          <div class="site-topbar__inner">
            <div class="site-topbar__details">
              {contactLocation?.addressLines.length && contactLocation.mapUrl
                ? <a class="site-topbar__address" href={contactLocation.mapUrl} target="_blank" rel="noopener noreferrer">{contactLocation.addressLines.map((line) => <span>{line}</span>)}</a>
                : contactLocation?.addressLines.length ? <span>{contactLocation.addressLines.join(", ")}</span> : null}
              {contactLocation?.phone && <a href={`tel:${contactLocation.phone.replace(/[^\d+]/g, "")}`}>{phoneLabel(contactLocation.phone)}</a>}
              {!contactLocation?.addressLines.length && contactLocation?.mapUrl && <a href={contactLocation.mapUrl} target="_blank" rel="noopener noreferrer">Directions<span class="sr-only"> to {contactLocation.name}</span></a>}
              {directoryLink && <a href={directoryLink}>{currentLocation ? "All locations" : "Find a location"}</a>}
            </div>
            <SocialLinks links={socialLinks} placement="topbar" />
            {topbarCta && <a class="site-topbar__cta" href={topbarCta.url} target="_blank" rel="noopener noreferrer">{topbarCta.text}</a>}
          </div>
        </div>
      )}
      <div class="site-header" data-logo-size={headerLogoSize}>
        <a class="site-brand" href="/" aria-label={site.name + " home"}>
          {site.logo
            ? <img src={site.logo.url} alt="" width={site.logo.width || 160} height={site.logo.height || 48} />
            : <span>{site.name}</span>}
        </a>
        {navigation.length > 0 && (
          <>
            <button
              class="site-menu-toggle"
              type="button"
              aria-label="Open navigation"
              aria-expanded="false"
              aria-controls="site-primary-navigation"
              hidden
            >
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </button>
            <nav class="site-header__navigation" id="site-primary-navigation" aria-label="Primary navigation">
              <NavigationTree items={navigation} variant="header" pathname={pathname} activeSectionPaths={menuSectionPaths} />
            </nav>
          </>
        )}
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
      {pathname === "/" && showLegacyLocationHours && <LocationHoursSection locations={locations} />}
    </main>
    {pathname !== "/" && showLegacyLocationHours && <LocationHoursSection locations={locations} />}
    <footer class="site-footer">
      {showLocationHoursFooter && (
        <LocationDirectoryPage
          locations={footerLocations}
          section={{ heading: "Location & Hours", intro: "", layout: "visit-panel", isPrimary: false, condensed: footerLocations.length > 1 }}
        />
      )}
      <div class="site-footer__base">
        <div class="site-footer__base-inner">
          <a class="site-footer__brand" href="/" aria-label={site.name + " home"}>
            {site.logo ? <img src={site.logo.url} alt="" width={site.logo.width || 160} height={site.logo.height || 48} /> : <span>{site.name}</span>}
          </a>
          {footerNavigation.length > 0 && (
            <nav class="site-footer__navigation" aria-label="Footer navigation">
              <NavigationTree items={footerNavigation} variant="footer" pathname={pathname} />
            </nav>
          )}
          <SocialLinks links={socialLinks} placement="footer" />
          <small>© {new Date().getFullYear()} {site.name}</small>
        </div>
      </div>
      {mobileAction && (
        <a
          class="site-mobile-action"
          href={mobileAction.url}
          target={mobileAction.newWindow ? "_blank" : undefined}
          rel={mobileAction.newWindow ? "noopener noreferrer" : undefined}
        >{mobileAction.text}</a>
      )}
    </footer>
  </body>
</html>

<script>
  document.querySelectorAll<HTMLElement>(".site-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".site-menu-toggle");
    const navigation = header.querySelector<HTMLElement>(".site-header__navigation");
    if (!toggle || !navigation) return;

    const closeMenu = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open navigation");
      navigation.removeAttribute("data-open");
      document.body.classList.remove("site-navigation-open");
    };

    toggle.hidden = false;
    header.classList.add("site-header--enhanced");
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
      if (isOpen) navigation.removeAttribute("data-open");
      else navigation.setAttribute("data-open", "");
      document.body.classList.toggle("site-navigation-open", !isOpen);
    });

    navigation.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) closeMenu();
    });

    header.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || toggle.getAttribute("aria-expanded") !== "true") return;
      closeMenu();
      toggle.focus();
    });
  });
</script>
