---
import "../styles/global.css";
import LocationHoursSection from "../components/LocationHoursSection.astro";
import SiteAlerts from "../components/SiteAlerts.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { alertsForPath } from "../lib/backstage/alerts";
import { richTextToPlainText } from "../lib/sanitize-rich-text";
import type { HeadlessPage, HeadlessWebsite, SiteNavigationItem } from "../lib/backstage/content";
import type { SiteLocation } from "../lib/backstage/locations";

interface Props {
  page?: HeadlessPage;
  pageTitle?: string | null;
  pageDescription?: string | null;
  pageImage?: string | null;
  contentType?: "website" | "article";
  site: HeadlessWebsite;
  pathname: string;
  navigation: SiteNavigationItem[];
  footerNavigation?: SiteNavigationItem[];
  routePaths: string[];
  alerts: import("@antlur/backstage").Alert[];
  locations: SiteLocation[];
  showLocationHours?: boolean;
}

const { page, pageTitle: routeTitle, pageDescription: routeDescription, pageImage, contentType = "website", site, pathname, navigation, footerNavigation = [], routePaths, alerts, locations, showLocationHours = true } = Astro.props;
const siteTitle = site.meta?.title || site.name;
const pageTitle = routeTitle || page?.meta?.title || page?.title || siteTitle;
const title = pageTitle === siteTitle || pageTitle.endsWith(" | " + siteTitle)
  ? pageTitle
  : pageTitle + " | " + siteTitle;
const description = richTextToPlainText(routeDescription || page?.meta?.description || site.openGraph?.description || site.meta?.description || pageTitle);
const openGraphTitle = routeTitle || page?.meta?.title || site.openGraph?.title || title;
const openGraphDescription = richTextToPlainText(routeDescription || page?.meta?.description || site.openGraph?.description || description);
const openGraphImage = pageImage || site.openGraph?.image;
const canonicalUrl = Astro.site ? new URL(pathname, Astro.site).href : undefined;
const indexable = import.meta.env.SITE_INDEXABLE === "true" && Boolean(Astro.site);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: Astro.site?.href,
  logo: site.logo?.url,
};
const jsonLd = JSON.stringify(organization).replace(/</g, "\\u003c");
const firstLocation = locations[0];
const primaryAction = navigation.find((item) => item.style === "button");
const topbarCta = site.homeCta && navigation.some((item) => item.style === "button" && item.url === site.homeCta?.url)
  ? null
  : site.homeCta;
const mobileAction = primaryAction
  ? { text: primaryAction.text, url: primaryAction.url, newWindow: primaryAction.newWindow }
  : site.homeCta ? { ...site.homeCta, newWindow: false } : null;
const showTopbar = Boolean(firstLocation?.phone || firstLocation?.addressLines.length || firstLocation?.mapUrl || topbarCta);
const socialLinks = site.socialLinks;
const visibleAlerts = alertsForPath(alerts, pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={indexable ? "index,follow" : "noindex,nofollow"} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#294c3d" />
    <link rel="icon" href={site.faviconUrl || "/favicon.svg"} />
    {site.appleIconUrl && <link rel="apple-touch-icon" href={site.appleIconUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={openGraphTitle} />
    <meta property="og:description" content={openGraphDescription} />
    {openGraphImage && <meta property="og:image" content={openGraphImage} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content={openGraphImage ? "summary_large_image" : "summary"} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class:list={["bg-background", "text-foreground", "font-body", mobileAction && "has-mobile-action"]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteAlerts alerts={visibleAlerts} siteDomain={site.domain} routePaths={routePaths} />
    <header class="site-header-shell">
      {showTopbar && (
        <div class="site-topbar">
          <div class="site-topbar__inner">
            <div class="site-topbar__details">
              {firstLocation?.addressLines.length && firstLocation.mapUrl
                ? <a class="site-topbar__address" href={firstLocation.mapUrl} target="_blank" rel="noopener noreferrer" aria-label={`Directions to ${firstLocation.name}`}>{firstLocation.addressLines.map((line) => <span>{line}</span>)}</a>
                : firstLocation?.addressLines.length ? <span>{firstLocation.addressLines.join(", ")}</span> : null}
              {firstLocation?.phone && <a href={`tel:${firstLocation.phone.replace(/[^\d+]/g, "")}`}>{firstLocation.phone}</a>}
              {!firstLocation?.addressLines.length && firstLocation?.mapUrl && <a href={firstLocation.mapUrl} target="_blank" rel="noopener noreferrer">Directions<span class="sr-only"> to {firstLocation.name}</span></a>}
            </div>
            {topbarCta && <a class="site-topbar__cta" href={topbarCta.url} target="_blank" rel="noopener noreferrer">{topbarCta.text}</a>}
          </div>
        </div>
      )}
      <div class="site-header">
        <a class="site-brand" href="/" aria-label={site.name + " home"}>
          {site.logo
            ? <img src={site.logo.url} alt="" width={site.logo.width || 160} height={site.logo.height || 48} />
            : <span>{site.name}</span>}
        </a>
        {navigation.length > 0 && (
          <>
            <button
              class="site-menu-toggle"
              type="button"
              aria-label="Open navigation"
              aria-expanded="false"
              aria-controls="site-primary-navigation"
              hidden
            >
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </button>
            <nav class="site-header__navigation" id="site-primary-navigation" aria-label="Primary navigation">
              <ul class="site-nav">
                {navigation.map((item) => (
                  <li class="site-nav-item">
                    <a
                      class={item.style === "button" ? "site-nav-link site-nav-link--button" : "site-nav-link"}
                      href={item.url}
                      target={item.newWindow ? "_blank" : undefined}
                      rel={item.newWindow ? "noopener noreferrer" : undefined}
                      aria-current={pathname === item.url ? "page" : undefined}
                    >{item.text}</a>
                    {item.children.length > 0 && (
                      <details class="site-nav-menu">
                        <summary aria-label={`Show ${item.text} pages`}><span aria-hidden="true"></span></summary>
                        <ul class="site-nav-children" aria-label={item.text + " links"}>
                          {item.children.map((child) => (
                            <li>
                              <a
                                href={child.url}
                                target={child.newWindow ? "_blank" : undefined}
                                rel={child.newWindow ? "noopener noreferrer" : undefined}
                                aria-current={pathname === child.url ? "page" : undefined}
                              >{child.text}</a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          </>
        )}
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {showLocationHours && locations.length > 0 && <LocationHoursSection locations={locations} />}
    <footer class="site-footer">
      <div class="site-footer__base">
        <div class="site-footer__base-inner">
          <a class="site-footer__brand" href="/" aria-label={site.name + " home"}>
            {site.logo ? <img src={site.logo.url} alt="" width={site.logo.width || 160} height={site.logo.height || 48} /> : <span>{site.name}</span>}
          </a>
          {footerNavigation.length > 0 && (
            <nav aria-label="Footer navigation">
              {footerNavigation.map((item) => <a href={item.url} target={item.newWindow ? "_blank" : undefined} rel={item.newWindow ? "noopener noreferrer" : undefined}>{item.text}</a>)}
            </nav>
          )}
          {socialLinks.length > 0 && (
            <nav class="site-footer__social" aria-label="Social media">
              {socialLinks.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.name} (opens in a new tab)`}>
                  <SocialIcon name={link.name} />
                </a>
              ))}
            </nav>
          )}
          <small>© {new Date().getFullYear()} {site.name}</small>
        </div>
      </div>
    </footer>
    {mobileAction && (
      <a
        class="site-mobile-action"
        href={mobileAction.url}
        target={mobileAction.newWindow ? "_blank" : undefined}
        rel={mobileAction.newWindow ? "noopener noreferrer" : undefined}
      >{mobileAction.text}</a>
    )}
  </body>
</html>

<script>
  document.querySelectorAll<HTMLElement>(".site-header").forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>(".site-menu-toggle");
    const navigation = header.querySelector<HTMLElement>(".site-header__navigation");
    if (!toggle || !navigation) return;

    const closeMenu = () => {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open navigation");
      navigation.removeAttribute("data-open");
      document.body.classList.remove("site-navigation-open");
    };

    toggle.hidden = false;
    header.classList.add("site-header--enhanced");
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
      if (isOpen) navigation.removeAttribute("data-open");
      else navigation.setAttribute("data-open", "");
      document.body.classList.toggle("site-navigation-open", !isOpen);
    });

    navigation.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) closeMenu();
    });

    header.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || toggle.getAttribute("aria-expanded") !== "true") return;
      closeMenu();
      toggle.focus();
    });
  });
</script>
