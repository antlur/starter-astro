{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:card-grid@1",
  "name": "Card Grid",
  "slug": "card-grid",
  "description": "A responsive set of image and text cards for featured content, services, or destinations.",
  "schema": {
    "fields": [
      { "name": "Eyebrow", "slug": "eyebrow", "type": "text", "order": 0 },
      { "name": "Heading", "slug": "heading", "type": "text", "order": 1 },
      { "name": "Introduction", "slug": "intro", "type": "rich_text", "order": 2 },
      {
        "name": "Cards",
        "slug": "cards",
        "type": "repeater",
        "fields": [
          { "name": "Image", "slug": "image", "type": "image", "order": 0 },
          { "name": "Image alt text", "slug": "imageAlt", "type": "text", "order": 1 },
          { "name": "Title", "slug": "title", "type": "text", "required": true, "order": 2 },
          { "name": "Description", "slug": "body", "type": "rich_text", "order": 3 },
          { "name": "Link label", "slug": "link_label", "type": "text", "order": 4 },
          { "name": "Link URL", "slug": "link_url", "type": "url", "order": 5 }
        ],
        "order": 3
      }
    ]
  }
}
