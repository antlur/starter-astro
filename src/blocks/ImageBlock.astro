---
import type { HeadlessBlock } from "../lib/backstage/content";
import { mediaAltText, mediaDimensions, safeAltText, safeImageUrl } from "../lib/safe-url";

interface Props {
  block: HeadlessBlock;
}

const { block } = Astro.props;
const media = block.fields.image;
const src = safeImageUrl(media);
const dimensions = mediaDimensions(media);
const imageAlt = safeAltText(block.fields.imageAlt) || mediaAltText(media);
const caption = typeof block.fields.caption === "string" ? block.fields.caption.trim() : "";
---

{src && (
  <section class="image-block">
    <figure>
      <img src={src} alt={imageAlt} width={dimensions?.width} height={dimensions?.height} loading="lazy" decoding="async" />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  </section>
)}

<style>
  .image-block {
    padding: clamp(2rem, 5vw, 4rem) max(1.5rem, calc((100vw - 74rem) / 2));
  }

  figure {
    max-width: 74rem;
    margin: 0 auto;
  }

  img {
    display: block;
    width: 100%;
    max-height: 68vh;
    object-fit: contain;
    background: var(--color-line);
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
