{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:locations@1",
  "name": "Locations",
  "slug": "locations",
  "description": "Display published locations and their available services without re-entering addresses or links.",
  "schema": {
    "fields": [
      { "name": "Heading", "slug": "heading", "type": "text", "placeholder": "Our locations", "order": 0 },
      { "name": "Introduction", "slug": "intro", "type": "rich_text", "order": 1 },
      {
        "name": "Layout",
        "slug": "layout",
        "type": "select",
        "options": [
          { "label": "Compact list (default)", "value": "compact" },
          { "label": "Photo grid", "value": "photo-grid" }
        ],
        "order": 2
      }
    ]
  }
}
