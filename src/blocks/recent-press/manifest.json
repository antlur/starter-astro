{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:recent-press@1",
  "name": "Recent Press",
  "slug": "recent-press",
  "description": "Show the newest published press items managed in Backstage.",
  "schema": {
    "fields": [
      { "name": "Eyebrow", "slug": "eyebrow", "type": "text", "order": 0 },
      { "name": "Heading", "slug": "heading", "type": "text", "order": 1 },
      { "name": "Number of press items", "slug": "count", "type": "number", "placeholder": "3", "order": 2 },
      { "name": "View all label", "slug": "view_all_label", "type": "text", "placeholder": "View all press", "order": 3 }
    ]
  }
}
