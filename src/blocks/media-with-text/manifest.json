{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:media-with-text@1",
  "name": "Media With Text",
  "slug": "media-with-text",
  "description": "An editorial image and rich-text section with a reversible layout.",
  "schema": {
    "fields": [
      { "name": "Eyebrow", "slug": "eyebrow", "type": "text", "order": 0 },
      { "name": "Heading", "slug": "heading", "type": "text", "order": 1 },
      { "name": "Subheading", "slug": "subheading", "type": "text", "order": 2 },
      { "name": "Body", "slug": "body", "type": "rich_text", "order": 3 },
      { "name": "Image", "slug": "image", "type": "image", "order": 4 },
      {
        "name": "Image alt text",
        "slug": "imageAlt",
        "type": "text",
        "description": "Describe meaningful images; leave blank when the image is decorative.",
        "order": 5
      },
      {
        "name": "Image position",
        "slug": "image_position",
        "type": "select",
        "placeholder": "Left (default)",
        "options": [
          { "label": "Left", "value": "left" },
          { "label": "Right", "value": "right" }
        ],
        "order": 6
      },
      {
        "name": "Section width",
        "slug": "section_width",
        "type": "select",
        "placeholder": "Standard (default)",
        "options": [
          { "label": "Standard", "value": "standard" },
          { "label": "Full width", "value": "full-width" }
        ],
        "order": 7
      },
      { "name": "Call to action label", "slug": "cta_label", "type": "text", "order": 8 },
      { "name": "Call to action URL", "slug": "cta_url", "type": "url", "order": 9 }
    ]
  }
}
