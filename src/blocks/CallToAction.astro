---
import { sanitizeRichText } from "../lib/sanitize-rich-text";
import type { HeadlessBlock } from "../lib/backstage/content";
import { safeLinkUrl } from "../lib/safe-url";

interface Props {
  block: HeadlessBlock;
  isPrimary: boolean;
}

const { block, isPrimary } = Astro.props;
const text = (key: string): string =>
  typeof block.fields[key] === "string" ? (block.fields[key] as string).trim() : "";
const eyebrow = text("eyebrow");
const heading = text("heading");
const body = text("body") ? sanitizeRichText(text("body")) : "";
const actions = Array.isArray(block.fields.actions)
  ? block.fields.actions.flatMap((value) => {
      if (typeof value !== "object" || value === null || Array.isArray(value)) return [];
      const action = value as Record<string, unknown>;
      const label = typeof action.label === "string" ? action.label.trim() : "";
      const href = safeLinkUrl(action.href);
      return label && href ? [{ label, href }] : [];
    })
  : [];
const legacyLabel = text("button_label");
const legacyHref = safeLinkUrl(block.fields.button_url);
const actionLinks = actions.length > 0
  ? actions
  : legacyLabel && legacyHref
    ? [{ label: legacyLabel, href: legacyHref }]
    : [];
const HeadingTag = isPrimary ? "h1" : "h2";
---

<section class="call-to-action">
  <div class="call-to-action__inner">
    <div class="call-to-action__copy">
      {eyebrow && <p class="call-to-action__eyebrow">{eyebrow}</p>}
      {heading && <HeadingTag>{heading}</HeadingTag>}
      {body && <div class="call-to-action__body" set:html={body} />}
    </div>
    {actionLinks.length > 0 && (
      <div class="call-to-action__actions">
        {actionLinks.map((action, index) => (
          <a class:list={["call-to-action__button", index > 0 && "call-to-action__button--secondary"]} href={action.href}>{action.label}</a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .call-to-action {
    padding: clamp(3rem, 6vw, 5rem) max(1.5rem, calc((100vw - 74rem) / 2));
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .call-to-action__inner {
    display: flex;
    max-width: 74rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin: 0 auto;
  }

  .call-to-action__copy {
    max-width: 50rem;
  }

  .call-to-action__eyebrow {
    margin: 0 0 0.8rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1,
  h2 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 560;
    line-height: 1.08;
    text-wrap: balance;
  }

  .call-to-action__body {
    margin-top: 1rem;
    color: rgb(255 255 255 / 0.78);
    line-height: 1.7;
  }

  .call-to-action__body :global(p) {
    margin: 0;
  }

  .call-to-action__body :global(p + p) {
    margin-top: 0.75rem;
  }

  .call-to-action__button {
    display: inline-flex;
    min-height: 3rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.25rem;
    border-radius: 0.4rem;
    background: var(--color-accent);
    color: var(--color-ink);
    font-weight: 750;
    text-decoration: none;
  }

  .call-to-action__actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .call-to-action__button--secondary {
    border: 1px solid rgb(255 255 255 / 0.5);
    background: transparent;
    color: var(--color-paper);
  }

  .call-to-action__button:hover {
    background: white;
    color: var(--color-ink);
  }

  .call-to-action__button--secondary:hover {
    border-color: white;
  }

  @media (max-width: 700px) {
    .call-to-action {
      padding-inline: 1.25rem;
    }

    .call-to-action__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    h1,
    h2 {
      font-size: 2.25rem;
    }
  }
</style>
