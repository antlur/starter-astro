{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:featured-press@1",
  "name": "Featured Press",
  "slug": "featured-press",
  "description": "Show the latest featured published press item managed in Backstage.",
  "schema": {
    "fields": [
      { "name": "Eyebrow", "slug": "eyebrow", "type": "text", "order": 0 },
      { "name": "Heading", "slug": "heading", "type": "text", "order": 1 },
      { "name": "View all label", "slug": "view_all_label", "type": "text", "placeholder": "View all press", "order": 2 }
    ]
  }
}
