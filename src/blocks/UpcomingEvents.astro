---
import type { HeadlessBlock } from "../lib/backstage/content";
import { eventScheduleLabels, selectUpcomingEvents } from "../lib/backstage/events";
import { sanitizeRichText } from "../lib/sanitize-rich-text";
import { safeSiteLinkUrl } from "../lib/safe-url";

interface Props {
  block: HeadlessBlock;
  isPrimary: boolean;
}

const { block, isPrimary } = Astro.props;
const text = (key: string): string =>
  typeof block.fields[key] === "string" ? (block.fields[key] as string).trim() : "";
const eyebrow = text("eyebrow");
const title = text("title");
const description = text("description") ? sanitizeRichText(text("description")) : "";
const viewAllLabel = text("view_all_label") || "View all events";
const eventsIndexHref = safeSiteLinkUrl(block.eventsIndexPath);
const events = selectUpcomingEvents(block.events ?? [], block.fields.count);
const scheduledEvents = events.map((event) => ({ event, schedule: eventScheduleLabels(event) }));
const HeadingTag = isPrimary ? "h1" : "h2";
---

<section
  class="upcoming-events"
  aria-labelledby={title ? `events-${block.id}` : undefined}
  aria-label={title ? undefined : "Upcoming events"}
>
  <div class="upcoming-events__intro">
    {eyebrow && <p class="upcoming-events__eyebrow">{eyebrow}</p>}
    {title && <HeadingTag id={`events-${block.id}`}>{title}</HeadingTag>}
    {description && <div class="upcoming-events__description" set:html={description} />}
  </div>
  {events.length > 0 ? (
    <div class="upcoming-events__grid">
      {scheduledEvents.map(({ event, schedule }) => (
        <article class="upcoming-events__item">
          {event.imageUrl && (
            <img src={event.imageUrl} alt={event.imageAlt} width={event.imageWidth ?? 1200} height={event.imageHeight ?? 900} loading="lazy" decoding="async" />
          )}
          <div class="upcoming-events__copy">
            <p class="upcoming-events__date">
              <time datetime={event.startTime}>{schedule.startDate}</time>
              {schedule.endDate && (
                <> - <time datetime={event.endTime ?? undefined}>{schedule.endDate}</time></>
              )}
            </p>
            <p class="upcoming-events__time">
              <time datetime={event.startTime}>{schedule.startTime}</time>
              {schedule.endTime && (
                <> - <time datetime={event.endTime ?? undefined}>{schedule.endTime}</time></>
              )}
            </p>
            <h3>{event.title}</h3>
            {event.shortDescription && <p>{event.shortDescription}</p>}
            {(event.publicPath || event.ticketUrl) && (
              <div class="upcoming-events__actions">
                {event.publicPath && <a href={event.publicPath}>Event details<span class="sr-only"> for {event.title}</span></a>}
                {event.ticketUrl && (
                  <a href={event.ticketUrl} target="_blank" rel="noopener noreferrer">
                    Get tickets<span class="sr-only"> for {event.title}</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="upcoming-events__empty">No upcoming events are scheduled right now.</p>
  )}
  {events.length > 0 && eventsIndexHref && (
    <p class="upcoming-events__view-all"><a href={eventsIndexHref}>{viewAllLabel}</a></p>
  )}
</section>

<style>
  .upcoming-events {
    padding: clamp(3rem, 7vw, 6rem) max(1.25rem, calc((100vw - 74rem) / 2));
    background: #e8ece8;
  }

  .upcoming-events__intro {
    max-width: 44rem;
    margin-bottom: 2rem;
  }

  .upcoming-events__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 560;
    line-height: 1.05;
    text-wrap: balance;
  }

  .upcoming-events__description {
    margin-top: 0.9rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .upcoming-events__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }

  .upcoming-events__item {
    min-width: 0;
    overflow: hidden;
    background: var(--color-surface);
  }

  .upcoming-events__item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .upcoming-events__copy {
    padding: 1.25rem;
  }

  .upcoming-events__date,
  .upcoming-events__time {
    margin: 0;
  }

  .upcoming-events__date {
    color: var(--color-accent-strong);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .upcoming-events__time {
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  h3 {
    margin: 0.8rem 0 0.55rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .upcoming-events__copy p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .upcoming-events__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .upcoming-events__actions a,
  .upcoming-events__view-all a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--color-accent-strong);
    font-weight: 700;
    text-decoration: none;
  }

  .upcoming-events__actions a:last-child,
  .upcoming-events__view-all a {
    background: var(--color-accent-strong);
    color: white;
  }

  .upcoming-events__actions a:hover,
  .upcoming-events__view-all a:hover {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .upcoming-events__actions a:focus-visible,
  .upcoming-events__view-all a:focus-visible {
    outline: 3px solid var(--color-ink);
    outline-offset: 3px;
  }

  .upcoming-events__empty {
    margin: 0;
    color: var(--color-muted);
  }

  .upcoming-events__view-all {
    margin: 1.5rem 0 0;
  }

  .upcoming-events__view-all a {
    color: var(--color-accent-strong);
    font-weight: 750;
    text-underline-offset: 0.2em;
  }
</style>
