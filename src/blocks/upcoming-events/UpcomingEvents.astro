---
import EditorialLink from "../../components/EditorialLink.astro";
import type { HeadlessBlock } from "../../lib/backstage/content";
import { eventScheduleLabels, selectUpcomingEvents } from "../../lib/backstage/events";
import { sanitizeRichText } from "../../lib/sanitize-rich-text";
import { safeSiteLinkUrl } from "../../lib/safe-url";

interface Props {
  block: HeadlessBlock;
  isPrimary: boolean;
}

const { block, isPrimary } = Astro.props;
const text = (key: string): string =>
  typeof block.fields[key] === "string" ? (block.fields[key] as string).trim() : "";
const eyebrow = text("eyebrow");
const title = text("title");
const description = text("description") ? sanitizeRichText(text("description")) : "";
const viewAllLabel = text("view_all_label") || "View all events";
const eventsIndexHref = safeSiteLinkUrl(block.eventsIndexPath);
const events = selectUpcomingEvents(block.events ?? [], block.fields.count);
const scheduledEvents = events.map((event) => ({ event, schedule: eventScheduleLabels(event) }));
const HeadingTag = isPrimary ? "h1" : "h2";
const EventHeading = title ? "h3" : "h2";
---

<section
  class="upcoming-events"
  aria-labelledby={title ? `events-${block.id}` : undefined}
  aria-label={title ? undefined : "Upcoming events"}
>
  <header class="upcoming-events__header">
    <div class="upcoming-events__intro">
      {eyebrow && <p class="upcoming-events__eyebrow">{eyebrow}</p>}
      {title && <HeadingTag class="upcoming-events__heading" id={`events-${block.id}`}>{title}</HeadingTag>}
      {description && <div class="upcoming-events__description" set:html={description} />}
    </div>
    {events.length > 0 && eventsIndexHref && <EditorialLink href={eventsIndexHref} label={viewAllLabel} />}
  </header>
  {events.length > 0 ? (
    <div class="upcoming-events__grid">
      {scheduledEvents.map(({ event, schedule }) => (
        <article class="upcoming-events__item">
          {event.imageUrl && (
            <img src={event.imageUrl} alt={event.imageAlt} width={event.imageWidth ?? 1200} height={event.imageHeight ?? 900} loading="lazy" decoding="async" />
          )}
          <div class="upcoming-events__copy">
            <p class="upcoming-events__date">
              <time datetime={event.startTime}>{schedule.startDate}</time>
              {schedule.endDate && (
                <> - <time datetime={event.endTime ?? undefined}>{schedule.endDate}</time></>
              )}
            </p>
            <p class="upcoming-events__time">
              <time datetime={event.startTime}>{schedule.startTime}</time>
              {schedule.endTime && (
                <> - <time datetime={event.endTime ?? undefined}>{schedule.endTime}</time></>
              )}
            </p>
            <EventHeading class="upcoming-events__title">{event.title}</EventHeading>
            {event.shortDescription && <p class="upcoming-events__summary">{event.shortDescription}</p>}
            {(event.publicPath || event.ticketUrl) && (
              <div class="upcoming-events__actions">
                {event.publicPath && <EditorialLink href={event.publicPath} label="Event details" context={`for ${event.title}`} />}
                {event.ticketUrl && (
                  <a class="upcoming-events__tickets" href={event.ticketUrl} target="_blank" rel="noopener noreferrer">
                    Get tickets<span class="sr-only"> for {event.title}</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <p class="upcoming-events__empty">No upcoming events are scheduled right now.</p>
  )}
</section>

<style>
  .upcoming-events {
    padding: var(--ui-section-space) var(--ui-container-inset);
    background: var(--theme-color-surface);
    color: var(--theme-color-foreground);
  }

  .upcoming-events__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: var(--ui-section-heading-gap);
  }

  .upcoming-events__intro {
    max-width: 44rem;
    min-width: 0;
  }

  .upcoming-events__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .upcoming-events__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1.05;
    text-wrap: balance;
  }

  .upcoming-events__description {
    margin-top: 0.9rem;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .upcoming-events__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }

  .upcoming-events__item {
    min-width: 0;
  }

  .upcoming-events__item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .upcoming-events__copy {
    padding-top: 1rem;
  }

  .upcoming-events__date,
  .upcoming-events__time {
    margin: 0;
    font-size: 0.875rem;
  }

  .upcoming-events__date {
    color: var(--color-accent-strong);
    font-weight: 700;
  }

  .upcoming-events__time {
    margin-top: 0.2rem;
    color: var(--color-muted);
  }

  .upcoming-events__title {
    margin: 0.8rem 0 0.55rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.15;
  }

  .upcoming-events__summary {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .upcoming-events__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
  }

  .upcoming-events__tickets {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1rem;
    border-radius: var(--ui-radius-button);
    background: var(--color-accent-strong);
    color: var(--theme-color-primary-foreground);
    font-weight: 700;
    text-decoration: none;
  }

  .upcoming-events__tickets:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .upcoming-events__empty {
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .upcoming-events__header {
      flex-direction: column;
      align-items: start;
      gap: 0.25rem;
    }

    .upcoming-events__heading {
      font-size: 2.25rem;
    }
  }
</style>
