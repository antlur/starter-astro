---
import { sanitizeRichText } from "../lib/sanitize-rich-text";
import type { HeadlessBlock } from "../lib/backstage/content";

interface Props {
  block: HeadlessBlock;
  isPrimary: boolean;
}

const { block, isPrimary } = Astro.props;
const text = (key: string): string =>
  typeof block.fields[key] === "string" ? (block.fields[key] as string).trim() : "";
const eyebrow = text("eyebrow");
const heading = text("heading");
const body = text("body") ? sanitizeRichText(text("body")) : "";
const HeadingTag = isPrimary ? "h1" : "h2";
---

<section class="content-section">
  <div class="content-section__inner">
    {eyebrow && <p class="content-section__eyebrow">{eyebrow}</p>}
    {heading && <HeadingTag>{heading}</HeadingTag>}
    {body && <div class="content-section__body" set:html={body} />}
  </div>
</section>

<style>
  .content-section {
    padding: clamp(3.5rem, 8vw, 7rem) max(1.5rem, calc((100vw - 74rem) / 2));
  }

  .content-section__inner {
    max-width: 54rem;
    margin-inline: auto;
  }

  .content-section__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1,
  h2 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 560;
    line-height: 1.06;
    text-wrap: balance;
  }

  .content-section__body {
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .content-section__body :global(p) {
    margin: 0;
  }

  .content-section__body :global(p + p) {
    margin-top: 1rem;
  }

  .content-section__body :global(a) {
    color: var(--color-accent-strong);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }
</style>
