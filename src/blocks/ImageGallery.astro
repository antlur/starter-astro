---
import type { HeadlessBlock } from "../lib/backstage/content";
import { mediaAltText, mediaDimensions, safeAltText, safeImageUrl } from "../lib/safe-url";

interface Props {
  block: HeadlessBlock;
  isPrimary: boolean;
}

const { block, isPrimary } = Astro.props;
const text = (value: unknown): string => typeof value === "string" ? value.trim() : "";
const eyebrow = text(block.fields.eyebrow);
const heading = text(block.fields.heading);
const columns = ["2", "3", "4"].includes(text(block.fields.columns)) ? text(block.fields.columns) : "3";
const imageFit = text(block.fields.image_fit) === "contain" ? "contain" : "cover";
const images = Array.isArray(block.fields.images)
  ? block.fields.images.flatMap((value) => {
      if (typeof value !== "object" || value === null || Array.isArray(value)) return [];
      const item = value as Record<string, unknown>;
      const src = safeImageUrl(item.image);
      const dimensions = mediaDimensions(item.image);
      return src ? [{ src, ...dimensions, alt: safeAltText(item.imageAlt) || mediaAltText(item.image), caption: text(item.caption) }] : [];
    })
  : [];
const HeadingTag = isPrimary ? "h1" : "h2";
---

{images.length > 0 && (
  <section class="image-gallery" aria-label={heading || "Image gallery"}>
    {(eyebrow || heading) && (
      <header class="image-gallery__header">
        {eyebrow && <p class="image-gallery__eyebrow">{eyebrow}</p>}
        {heading && <HeadingTag>{heading}</HeadingTag>}
      </header>
    )}
    <div class:list={["image-gallery__grid", imageFit === "contain" && "image-gallery__grid--contain"]} style={`--gallery-columns: ${columns}`}>
      {images.map((item) => (
        <figure>
          <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .image-gallery {
    padding: clamp(3rem, 7vw, 6rem) max(1.5rem, calc((100vw - 74rem) / 2));
  }

  .image-gallery__header {
    margin: 0 auto 1.75rem;
  }

  .image-gallery__eyebrow {
    margin: 0 0 0.7rem;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 560;
    line-height: 1.08;
    text-wrap: balance;
  }

  .image-gallery__grid {
    display: grid;
    grid-template-columns: repeat(var(--gallery-columns), minmax(0, 1fr));
    gap: 0.85rem;
  }

  figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #e2e6e2;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .image-gallery__grid:not(.image-gallery__grid--contain) figure:hover img {
    transform: scale(1.025);
  }

  .image-gallery__grid--contain figure {
    align-self: start;
    background: var(--color-surface);
  }

  .image-gallery__grid--contain img {
    aspect-ratio: auto;
    object-fit: contain;
  }

  figcaption {
    padding: 0.65rem 0.75rem;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.4;
  }

  @media (max-width: 760px) {
    .image-gallery {
      padding-inline: 1.25rem;
    }

    .image-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 440px) {
    .image-gallery__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    img {
      transition: none;
    }
  }
</style>
