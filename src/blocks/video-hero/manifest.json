{
  "manifest_version": 1,
  "type": "block",
  "registry_identity": "starter-astro:video-hero@1",
  "name": "Video Hero",
  "slug": "video-hero",
  "description": "A cinematic page introduction with a muted background video and optional text and actions.",
  "schema": {
    "fields": [
      { "name": "Eyebrow", "slug": "eyebrow", "type": "text", "order": 0 },
      { "name": "Heading", "slug": "heading", "type": "text", "order": 1 },
      { "name": "Body", "slug": "body", "type": "rich_text", "order": 2 },
      {
        "name": "Background video",
        "slug": "video",
        "type": "media",
        "required": true,
        "description": "Select an MP4, WebM, or Ogg video from the media library.",
        "order": 3
      },
      {
        "name": "Poster image",
        "slug": "poster",
        "type": "image",
        "description": "Shown before playback and when reduced motion is enabled.",
        "order": 4
      },
      {
        "name": "Actions",
        "slug": "actions",
        "type": "repeater",
        "fields": [
          { "name": "Label", "slug": "label", "type": "text", "required": true, "order": 0 },
          { "name": "URL", "slug": "href", "type": "url", "required": true, "order": 1 }
        ],
        "order": 5
      }
    ]
  }
}
