---
import type { LocationService, SiteLocation } from "../lib/backstage/locations";
import { analyticsLink, serviceAnalytics } from "../lib/analytics";
import { locationServiceLinks, locationServices } from "../site/location-choices";

interface Props {
  location: SiteLocation;
  service?: LocationService;
  placement?: "location_card" | "location_page";
}

const { location, service, placement = "location_page" } = Astro.props;
const services = service ? [service] : Object.keys(locationServices) as LocationService[];
const actions = services.flatMap((kind) => {
  const links = locationServiceLinks(location, kind);
  return links.map((link) => ({
    ...link,
    analytics: serviceAnalytics[kind],
    label: links.length > 1 ? `${locationServices[kind].label} via ${link.service}` : locationServices[kind].label,
  }));
});
---

{actions.length > 0 && (
  <ul class="location-actions" aria-label={`Services at ${location.name}`}>
    {actions.map(({ url, label, analytics: { name, ...params } }) => (
      <li><a href={url} {...analyticsLink(name, { ...params, location: placement, store: location.slug })}>{label}<span class="sr-only"> at {location.name}</span></a></li>
    ))}
  </ul>
)}

<style>
  .location-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 1rem 0 0; list-style: none; }
  .location-actions a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.55rem 0.85rem;
    color: var(--theme-color-action);
    border: 1px solid currentColor;
    border-radius: var(--ui-radius-button);
    font-weight: 650;
    overflow-wrap: anywhere;
    text-underline-offset: 0.18em;
  }
  .location-actions a:hover { background: var(--theme-color-action); color: var(--theme-color-primary-foreground); }
</style>
