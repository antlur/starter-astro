---
import { sanitizeRichText } from "../lib/sanitize-rich-text";
import type { SiteLocation } from "../lib/backstage/locations";

interface Props {
  locations: Array<{ path: string; location: SiteLocation }>;
}

const locations = Astro.props.locations.toSorted((left, right) => left.location.name.localeCompare(right.location.name));
---

<section class="location-directory" aria-labelledby="location-directory-title">
  <header class="location-directory__intro">
    <p class="location-directory__eyebrow">Find us</p>
    <h1 id="location-directory-title">Our locations</h1>
    <p>Find a location, get directions, and plan your visit.</p>
  </header>

  {locations.length > 0 ? (
    <div class="location-directory__grid">
      {locations.map(({ path, location }) => {
        const description = location.description ? sanitizeRichText(location.description) : "";
        return (
          <article class="location-card">
            {location.imageUrl && <a class="location-card__image-link" href={path} aria-label={`Visit ${location.name}`}><img src={location.imageUrl} alt={location.imageAlt || location.name} loading="lazy" decoding="async" /></a>}
            <div class="location-card__content">
              <h2><a href={path}>{location.name}</a></h2>
              {location.addressLines.length > 0 && <address>{location.addressLines.map((line) => <span>{line}</span>)}</address>}
              {description && <div class="location-card__description" set:html={description} />}
              <div class="location-card__actions">
                <a class="location-card__visit" href={path}>Location details</a>
                {location.mapUrl && <a href={location.mapUrl} target="_blank" rel="noopener noreferrer">Directions<span class="sr-only"> to {location.name}</span></a>}
                {location.phone && <a href={`tel:${location.phone.replace(/[^\d+]/g, "")}`}>{location.phone}</a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  ) : (
    <p class="location-directory__empty">Location details are being updated. Please check back soon.</p>
  )}
</section>

<style>
  .location-directory {
    width: min(100% - 3rem, 74rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .location-directory__intro {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .location-directory__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent-strong);
    font-size: 0.82rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    line-height: 1.1;
    text-wrap: balance;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
  }

  .location-directory__intro > p:last-child {
    margin: 1rem 0 0;
    color: var(--color-muted);
    line-height: 1.7;
  }

  .location-directory__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }

  .location-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .location-card__image-link,
  .location-card__image-link img {
    display: block;
    width: 100%;
  }

  .location-card__image-link img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .location-card__content {
    padding: 1.5rem;
  }

  h2 {
    margin: 0 0 0.8rem;
    font-size: 1.8rem;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover,
  h2 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  address {
    display: grid;
    color: var(--color-muted);
    font-style: normal;
    line-height: 1.65;
  }

  .location-card__description {
    margin-top: 1rem;
    color: var(--color-muted);
    line-height: 1.65;
  }

  .location-card__description :global(p) { margin: 0; }

  .location-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1rem;
    margin-top: 1.25rem;
  }

  .location-card__actions a {
    color: var(--color-ink);
    font-weight: 650;
    text-underline-offset: 0.18em;
  }

  .location-card__actions .location-card__visit {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.65rem 1rem;
    background: var(--color-accent-strong);
    color: var(--color-primary-foreground);
    text-decoration: none;
  }

  .location-directory__empty {
    padding: 2rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
  }
</style>
