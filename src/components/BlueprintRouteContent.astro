---
import type { BlueprintRoute, PresentedField } from "../site/blueprint-routes";

interface Props {
  route: BlueprintRoute;
}

const { route } = Astro.props;

const renderField = (field: PresentedField) => field.value;
---

{route.kind === "index" ? (
  <section class="collection-page" aria-labelledby="collection-title">
    <header class="collection-heading">
      <p class="eyebrow">{route.blueprint.name}</p>
      <h1 id="collection-title">{route.blueprint.name}</h1>
      {route.blueprint.description && <p class="intro">{route.blueprint.description}</p>}
    </header>

    {route.entries.length > 0 ? (
      <ul class="entry-list">
        {route.entries.map((entry) => (
          <li>
            <article class="entry-summary">
              <h2><a href={entry.path}>{entry.title}</a></h2>
              {entry.fields.length > 0 && (
                <dl>
                  {entry.fields.map((field) => {
                    const value = renderField(field);

                    return (
                      <div class="summary-field">
                        <dt>{field.name}</dt>
                        <dd>
                          {value.kind === "text" && (value.href
                            ? <a href={value.href}>{value.text}</a>
                            : value.text)}
                          {value.kind === "html" && <span set:html={value.html} />}
                          {value.kind === "images" && value.images[0] && (
                            <img class="summary-image" src={value.images[0].src} alt={value.images[0].alt} width={value.images[0].width ?? 72} height={value.images[0].height ?? 56} loading="lazy" />
                          )}
                          {value.kind === "files" && value.files[0] && (
                            <a href={value.files[0].href}>{value.files[0].label}</a>
                          )}
                        </dd>
                      </div>
                    );
                  })}
                </dl>
              )}
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">There is no published content here yet.</p>
    )}
  </section>
) : (
  <article class="entry-page" aria-labelledby="entry-title">
    <header class="entry-heading">
      <p class="eyebrow">{route.blueprint.name}</p>
      <h1 id="entry-title">{route.title}</h1>
    </header>
    {route.fields.length > 0 ? (
      <dl class="entry-fields">
        {route.fields.map((field) => {
          const value = renderField(field);

          return (
            <div class="entry-field">
              <dt>{field.name}</dt>
              <dd>
                {value.kind === "text" && (value.href
                  ? <a href={value.href}>{value.text}</a>
                  : value.text)}
                {value.kind === "html" && <div class="rich-text" set:html={value.html} />}
                {value.kind === "images" && (
                  <div class="image-list">
                    {value.images.map((image) => (
                      <figure>
                        <img src={image.src} alt={image.alt} width={image.width ?? 1200} height={image.height ?? 900} loading="lazy" />
                        {image.alt !== field.name && <figcaption>{image.alt}</figcaption>}
                      </figure>
                    ))}
                  </div>
                )}
                {value.kind === "files" && (
                  <ul class="file-list">
                    {value.files.map((file) => <li><a href={file.href}>{file.label}</a></li>)}
                  </ul>
                )}
              </dd>
            </div>
          );
        })}
      </dl>
    ) : (
      <p class="empty-state">This entry has no published details.</p>
    )}
  </article>
)}

<style>
  .collection-page,
  .entry-page {
    width: min(100% - 3rem, 68rem);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 0 2rem;
  }

  .collection-heading,
  .entry-heading {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent-strong);
    font-size: 0.78rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1,
  h2,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 500;
    line-height: 1.05;
  }

  .intro {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .entry-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .entry-summary {
    height: 100%;
    padding: 1.4rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    background: #fff;
  }

  .entry-summary h2 {
    margin-bottom: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .entry-summary h2 a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  dl {
    margin: 0;
  }

  .entry-summary dl {
    display: grid;
    gap: 0.65rem;
  }

  .summary-field dt,
  .entry-field dt {
    margin-bottom: 0.2rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .summary-field dd,
  .entry-field dd {
    margin: 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .summary-image {
    display: block;
    width: 4.5rem;
    height: 3.5rem;
    border-radius: 0.3rem;
    object-fit: cover;
  }

  .entry-fields {
    border-top: 1px solid var(--color-line);
  }

  .entry-field {
    display: grid;
    grid-template-columns: minmax(9rem, 0.28fr) 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .entry-field dt {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
  }

  .image-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }

  .file-list {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.2rem;
  }

  figure {
    margin: 0;
  }

  figure img {
    display: block;
    width: 100%;
    max-height: 34rem;
    border-radius: 0.4rem;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .rich-text :global(p:first-child) {
    margin-top: 0;
  }

  .empty-state {
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  @media (max-width: 620px) {
    .collection-page,
    .entry-page {
      width: calc(100% - 2.5rem);
    }

    .entry-field {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    h1 {
      font-size: 2.5rem;
    }
  }
</style>
