---
import { GAEvents } from "@antlur/backstage/constants/google-events";
import { sanitizeRichText } from "../lib/sanitize-rich-text";
import { phoneLabel } from "../lib/phone-label";
import { analyticsLink } from "../lib/analytics";
import { responsivePhoto } from "../lib/responsive-photo";
import { getSiteContent, serializeJsonLd, structuredDataNodeForLocation } from "../lib/backstage/content";
import type { SiteLocation } from "../lib/backstage/locations";
import { menusForLocation, type SiteLocationRoute, type SiteMenuRoute } from "../site/menu-routes";
import LocationActions from "./LocationActions.astro";
import LocationSchedule from "./LocationSchedule.astro";

interface Props {
  location: SiteLocation;
  routePath: string;
  menuRoutes: SiteMenuRoute[];
  locationRoutes: SiteLocationRoute[];
}

const { location, routePath, menuRoutes, locationRoutes } = Astro.props;
const visibleMenuRoutes = menusForLocation({ path: routePath, location }, menuRoutes, locationRoutes);
const description = location.description ? sanitizeRichText(location.description) : "";
const { structuredData } = await getSiteContent();
const locationNode = structuredDataNodeForLocation(structuredData, location.id);
const locationSchema = locationNode ? serializeJsonLd(locationNode) : "";
const photoAttrs = location.imageUrl && location.imageWidth && location.imageHeight
  ? await responsivePhoto(location.imageUrl, { width: location.imageWidth, height: location.imageHeight },
    "(min-width: 1200px) 1152px, 100vw") : undefined;
---

{locationSchema && <script type="application/ld+json" set:html={locationSchema} />}

<section class="location-page" aria-labelledby="location-title">
  <header class="location-page__intro">
    <h1 id="location-title">Visit {location.name}</h1>
    {description && <div class="location-page__description" set:html={description} />}
  </header>

  <div class="location-page__details">
    <section class="location-page__visit" aria-labelledby="location-address-title">
      <h2 id="location-address-title">Plan your visit</h2>
      {location.addressLines.length > 0 && (
        <address>
          {location.addressLines.map((line) => <span>{line}</span>)}
        </address>
      )}
      <div class="location-page__links">
        {location.phone && <a href={`tel:${location.phone.replace(/[^\d+]/g, "")}`} {...analyticsLink(GAEvents.CLICK_TO_CALL, { location: "location_page", store: location.slug })}>{phoneLabel(location.phone)}</a>}
        {location.email && <a href={`mailto:${location.email}`}>{location.email}</a>}
        {location.mapUrl && <a href={location.mapUrl} target="_blank" rel="noopener noreferrer" {...analyticsLink(GAEvents.CLICK_TO_MAP, { location: "location_page", store: location.slug })}>Get directions</a>}
        {location.loyaltyUrl && <a href={location.loyaltyUrl} target="_blank" rel="noopener noreferrer">Join rewards</a>}
      </div>
      <LocationActions location={location} placement="location_page" />
      {visibleMenuRoutes.length > 0 && (
        <nav class="location-page__menus" aria-label={`${location.name} menus`}>
          <h3>Explore the menu</h3>
          {visibleMenuRoutes.map((route) => <a href={route.path}>{route.label}</a>)}
        </nav>
      )}
    </section>

    {(location.hours.length > 0 || Boolean(location.specialHours?.length)) && (
      <section class="location-page__hours" aria-labelledby="location-hours-title">
        <h2 id="location-hours-title">Hours</h2>
        <LocationSchedule location={location} />
      </section>
    )}
  </div>

  {location.imageUrl && <img class="location-page__image" src={photoAttrs?.src ?? location.imageUrl} srcset={photoAttrs?.srcset} sizes={photoAttrs?.sizes} alt={location.imageAlt} width={location.imageWidth ?? 1600} height={location.imageHeight ?? 800} loading="lazy" decoding="async" />}

  {location.mapEmbedUrl && (
    <section class="location-page__map" aria-label={`${location.name} map`}>
      <iframe
        src={location.mapEmbedUrl}
        title={`Map to ${location.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      />
    </section>
  )}
</section>

<style>
  .location-page {
    width: min(calc(100% - var(--ui-page-gutter) - var(--ui-page-gutter)), var(--ui-container-width));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .location-page__intro {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    line-height: 1.1;
    text-wrap: balance;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
  }

  .location-page__description {
    margin-top: 1rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .location-page__description :global(p) { margin: 0; }

  .location-page__image {
    display: block;
    width: 100%;
    max-height: 34rem;
    aspect-ratio: 16 / 8;
    height: auto;
    object-fit: cover;
    margin-top: 2.5rem;
    border-radius: var(--ui-radius-md);
  }

  .location-page__details {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr);
    gap: clamp(2rem, 8vw, 7rem);
    padding-block: 2rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.65rem, 3vw, 2.1rem);
  }

  .location-page address {
    display: grid;
    color: var(--color-muted);
    font-style: normal;
    line-height: 1.7;
  }

  .location-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 1rem;
  }

  .location-page__links a,
  .location-page__menus a {
    color: var(--color-accent-strong);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .location-page__menus { margin-top: 1.75rem; }
  .location-page__menus h3 { margin: 0 0 0.65rem; font-size: 1rem; }
  .location-page__menus a { display: inline-block; margin: 0 1rem 0.5rem 0; }

  .location-page__map {
    margin-top: 2.5rem;
    overflow: hidden;
    background: #e8ece8;
  }

  .location-page__map iframe {
    display: block;
    width: 100%;
    height: clamp(18rem, 42vw, 32rem);
    border: 0;
  }

  @media (max-width: 680px) {
    .location-page { padding-block: 2rem 3rem; }
    .location-page__intro { margin-bottom: 1.5rem; }
    .location-page__details { grid-template-columns: 1fr; gap: 2rem; }
    .location-page__image { aspect-ratio: 4 / 3; }
  }
</style>
