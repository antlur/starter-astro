---
import { sanitizeRichText } from "../lib/sanitize-rich-text";
import { locationSchemaUrl, type SiteLocation } from "../lib/backstage/locations";

interface Props {
  location: SiteLocation;
  routePath: string;
  menuRoutes: Array<{ path: string; label: string }>;
}

const { location, routePath, menuRoutes } = Astro.props;
const description = location.description ? sanitizeRichText(location.description) : "";
const locationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: location.name,
  address: location.addressLines.join(", "),
  telephone: location.phone ?? undefined,
  email: location.email ?? undefined,
  url: locationSchemaUrl(Astro.site, routePath),
  image: location.imageUrl ?? undefined,
  geo: location.latitude !== null && location.longitude !== null ? {
    "@type": "GeoCoordinates",
    latitude: location.latitude,
    longitude: location.longitude,
  } : undefined,
}).replace(/</g, "\\u003c");
---

<script type="application/ld+json" set:html={locationSchema} />

<section class="location-page" aria-labelledby="location-title">
  <header class="location-page__intro">
    <p class="location-page__eyebrow">Find us</p>
    <h1 id="location-title">Visit {location.name}</h1>
    {description && <div class="location-page__description" set:html={description} />}
  </header>

  {location.imageUrl && <img class="location-page__image" src={location.imageUrl} alt={location.imageAlt || location.name} fetchpriority="high" />}

  <div class="location-page__details">
    <section class="location-page__visit" aria-labelledby="location-address-title">
      <h2 id="location-address-title">Plan your visit</h2>
      {location.addressLines.length > 0 && (
        <address>
          {location.addressLines.map((line) => <span>{line}</span>)}
        </address>
      )}
      <div class="location-page__links">
        {location.phone && <a href={`tel:${location.phone.replace(/[^\d+]/g, "")}`}>{location.phone}</a>}
        {location.email && <a href={`mailto:${location.email}`}>{location.email}</a>}
        {location.mapUrl && <a href={location.mapUrl} target="_blank" rel="noopener noreferrer">Get directions</a>}
        {location.loyaltyUrl && <a href={location.loyaltyUrl} target="_blank" rel="noopener noreferrer">Join rewards</a>}
      </div>
      {menuRoutes.length > 0 && (
        <nav class="location-page__menus" aria-label={`${location.name} menus`}>
          <h3>Explore the menu</h3>
          {menuRoutes.map((route) => <a href={route.path}>{route.label}</a>)}
        </nav>
      )}
    </section>

    {location.hours.length > 0 && (
      <section class="location-page__hours" aria-labelledby="location-hours-title">
        <h2 id="location-hours-title">Hours</h2>
        <dl>
          {location.hours.map((hours) => <div><dt>{hours.day}</dt><dd>{hours.value}</dd></div>)}
        </dl>
      </section>
    )}
  </div>

  {location.mapEmbedUrl && (
    <section class="location-page__map" aria-label={`${location.name} map`}>
      <iframe
        src={location.mapEmbedUrl}
        title={`Map to ${location.name}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      />
    </section>
  )}
</section>

<style>
  .location-page {
    width: min(100% - 3rem, 72rem);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .location-page__intro {
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .location-page__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent-strong);
    font-size: 0.82rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  h1,
  h2 {
    font-family: var(--font-display);
    line-height: 1.1;
    text-wrap: balance;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
  }

  .location-page__description {
    margin-top: 1rem;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .location-page__description :global(p) { margin: 0; }

  .location-page__image {
    display: block;
    width: 100%;
    max-height: 34rem;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    margin-bottom: 2.5rem;
  }

  .location-page__details {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(15rem, 0.8fr);
    gap: clamp(2rem, 8vw, 7rem);
    padding-block: 2rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.65rem, 3vw, 2.1rem);
  }

  .location-page address {
    display: grid;
    color: var(--color-muted);
    font-style: normal;
    line-height: 1.7;
  }

  .location-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin-top: 1rem;
  }

  .location-page__links a,
  .location-page__menus a {
    color: var(--color-accent-strong);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .location-page__hours dl {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  .location-page__hours dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.55rem;
  }

  .location-page__hours dt { font-weight: 650; }
  .location-page__hours dd { margin: 0; color: var(--color-muted); text-align: right; }

  .location-page__menus { margin-top: 1.75rem; }
  .location-page__menus h3 { margin: 0 0 0.65rem; font-size: 1rem; }
  .location-page__menus a { display: inline-block; margin: 0 1rem 0.5rem 0; }

  .location-page__map {
    margin-top: 2.5rem;
    overflow: hidden;
    background: #e8ece8;
  }

  .location-page__map iframe {
    display: block;
    width: 100%;
    height: clamp(18rem, 42vw, 32rem);
    border: 0;
  }

  @media (max-width: 680px) {
    .location-page { width: calc(100% - 2rem); }
    .location-page__details { grid-template-columns: 1fr; gap: 2rem; }
    .location-page__image { aspect-ratio: 4 / 3; }
  }
</style>
