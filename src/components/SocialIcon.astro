---
interface Props {
  name: string;
}

const { name } = Astro.props;
const normalized = name.toLowerCase().replace(/[^a-z0-9]/g, "");
const network = normalized === "twitter" ? "x" : normalized;
const supported = ["facebook", "instagram", "tiktok", "x", "yelp", "youtube"].includes(network);
---

<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {network === "facebook" && (
    <path fill="currentColor" d="M13.6 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4v3.2h2.8V21h3.4z" />
  )}
  {network === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle class="social-icon__dot" cx="17.5" cy="6.5" r="0.8" />
    </>
  )}
  {network === "tiktok" && (
    <path fill="currentColor" d="M14 3h3c.2 2.2 1.6 3.8 4 4v3a10 10 0 0 1-4-1v6.2a5.7 5.7 0 1 1-5-5.7c.5 0 1 .1 1.5.2v3.1a2.5 2.5 0 1 0 .6 1.6V3z" />
  )}
  {network === "x" && (
    <path d="M5 4h3.7l10.2 16h-3.7L5 4zm14 0L5 20" />
  )}
  {network === "yelp" && (
    <g fill="currentColor" stroke="none">
      <path d="M11 2.8h2.2c.7 0 1 .4.9 1l-.8 6.1c-.1.8-.7 1.1-1.4.7L8.1 7.4c-.6-.4-.6-.9-.2-1.4l2-2.8c.2-.3.6-.4 1.1-.4z" />
      <path d="m16 8.6 4.1-2.3c.6-.3 1.1-.1 1.3.5l.8 2.2c.2.6-.1 1.1-.8 1.3l-4.6 1.2c-.7.2-1.2-.3-1.1-1l.1-1c0-.4.1-.7.2-.9z" />
      <path d="m17.2 14.2 3.5 3.5c.5.5.4 1-.1 1.4l-1.9 1.3c-.5.4-1 .2-1.3-.4l-2.1-4.2c-.3-.7 0-1.2.7-1.4l1.2-.2z" />
      <path d="m10.7 16.3-.6 4.8c-.1.7-.5 1-1.2.8l-2.2-.6c-.7-.2-.9-.7-.6-1.3l2.2-4c.4-.7 1-.8 1.5-.3l.6.6c.2.1.3.1.3 0z" />
      <path d="m7.5 12.8-4.8 1.1c-.7.2-1.1-.1-1.2-.8l-.2-2.3c0-.7.4-1 1.1-1l4.6.5c.8.1 1.1.7.8 1.3l-.3.6z" />
    </g>
  )}
  {network === "youtube" && (
    <>
      <rect x="2.5" y="5" width="19" height="14" rx="4" />
      <path class="social-icon__play" d="m10 9 5.5 3-5.5 3V9z" />
    </>
  )}
  {!supported && (
    <text x="12" y="17" text-anchor="middle">{name.trim().slice(0, 1).toUpperCase()}</text>
  )}
</svg>

<style>
  .social-icon {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .social-icon__dot,
  .social-icon__play {
    fill: currentColor;
    stroke: none;
  }

  text {
    fill: currentColor;
    stroke: none;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 800;
  }
</style>
