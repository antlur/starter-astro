---
import type { SiteNavigationItem } from "../lib/backstage/content";

interface Props {
  items: SiteNavigationItem[];
  variant: "header" | "footer";
  pathname?: string;
  depth?: number;
}

const { items, variant, pathname, depth = 0 } = Astro.props;
const listClass = variant === "header"
  ? depth === 0 ? "site-nav" : depth === 1 ? "site-nav-children" : "site-nav-children site-nav-children--nested"
  : depth === 0 ? "site-footer-nav-list" : "site-footer-nav-list site-footer-nav-list--nested";
---

<ul class={listClass}>
  {items.map((item) => (
    <li class={variant === "header" ? "site-nav-item" : "site-footer-nav-item"}>
      <a
        class={variant === "header" ? item.style === "button" ? "site-nav-link site-nav-link--button" : "site-nav-link" : undefined}
        href={item.url}
        target={item.newWindow ? "_blank" : undefined}
        rel={item.newWindow ? "noopener noreferrer" : undefined}
        aria-current={pathname === item.url ? "page" : undefined}
      >{item.text}</a>
      {item.children.length > 0 && variant === "header" && (
        <details class="site-nav-menu">
          <summary aria-label={`Show ${item.text} pages`}><span aria-hidden="true"></span></summary>
          <Astro.self items={item.children} variant={variant} pathname={pathname} depth={depth + 1} />
        </details>
      )}
      {item.children.length > 0 && variant === "footer" && (
        <Astro.self items={item.children} variant={variant} pathname={pathname} depth={depth + 1} />
      )}
    </li>
  ))}
</ul>
