---
import type { SiteLocation } from "../lib/backstage/locations";
import { sanitizeRichText } from "../lib/sanitize-rich-text";

interface Props {
  locations: SiteLocation[];
}

const { locations } = Astro.props;
---

<section class="location-hours" aria-labelledby="location-hours-title">
  <div class="location-hours__inner">
    <header class="location-hours__intro">
      <p>Find us</p>
      <h2 id="location-hours-title">Location &amp; Hours</h2>
    </header>
    <div class="location-hours__list">
      {locations.map((location) => {
        const description = location.description ? sanitizeRichText(location.description) : "";

        return (
          <article class="location-hours__location" aria-labelledby={`location-hours-${location.id}`}>
            <div class="location-hours__visit">
              <h3 id={`location-hours-${location.id}`}>{location.name}</h3>
              {description && <div class="location-hours__description" set:html={description} />}
              {location.addressLines.length > 0 && (
                <address>
                  {location.addressLines.map((line) => <span>{line}</span>)}
                </address>
              )}
              <div class="location-hours__contact">
                {location.phone && <a href={`tel:${location.phone.replace(/[^\d+]/g, "")}`}>{location.phone}</a>}
                {location.mapUrl && <a class="location-hours__directions" href={location.mapUrl} target="_blank" rel="noopener noreferrer">Get directions<span class="sr-only"> to {location.name}</span></a>}
              </div>
            </div>
            {location.hours.length > 0 && (
              <section class="location-hours__hours" aria-label={`${location.name} hours`}>
                <h4>Hours</h4>
                <dl>
                  {location.hours.map((hours) => (
                    <div><dt>{hours.day}</dt><dd>{hours.value}</dd></div>
                  ))}
                </dl>
              </section>
            )}
            {location.mapEmbedUrl && (
              <div class="location-hours__map">
                <iframe
                  src={location.mapEmbedUrl}
                  title={`Map to ${location.name}`}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .location-hours {
    padding: 4rem 1.5rem;
    background: var(--color-footer-location);
    color: var(--color-footer-location-foreground);
  }

  .location-hours__inner {
    width: min(100%, 74rem);
    margin-inline: auto;
  }

  .location-hours__intro {
    margin-bottom: 2rem;
  }

  .location-hours__intro p {
    margin: 0 0 0.65rem;
    opacity: 0.85;
    font-size: 0.8rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .location-hours__intro h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.1;
    text-wrap: balance;
  }

  .location-hours__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: 2rem;
  }

  .location-hours__location {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.85fr);
    align-items: start;
    gap: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .location-hours__map {
    grid-column: 1 / -1;
    overflow: hidden;
    background: #e8ece8;
  }

  .location-hours__map iframe {
    display: block;
    width: 100%;
    height: clamp(16rem, 30vw, 24rem);
    border: 0;
  }

  .location-hours__visit h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .location-hours__description,
  .location-hours address {
    margin-top: 0.7rem;
    opacity: 0.9;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .location-hours__description :global(p) {
    margin: 0;
  }

  .location-hours address {
    display: grid;
    font-style: normal;
  }

  .location-hours__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
  }

  .location-hours__contact a {
    color: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .location-hours__directions {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.55rem 0.9rem;
    background: var(--color-accent-strong);
    color: var(--color-primary-foreground) !important;
    text-decoration: none;
  }

  .location-hours__hours h4 {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    font-weight: 750;
  }

  .location-hours__hours dl {
    display: grid;
    gap: 0.35rem;
    margin: 0;
  }

  .location-hours__hours dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .location-hours__hours dt {
    font-weight: 650;
  }

  .location-hours__hours dd {
    margin: 0;
    opacity: 0.9;
    text-align: right;
  }

  @media (max-width: 680px) {
    .location-hours {
      padding: 3rem 1rem;
    }

    .location-hours__intro h2 {
      font-size: 1.9rem;
    }

    .location-hours__location {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
