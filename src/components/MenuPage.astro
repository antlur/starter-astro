---
import { sanitizeRichText } from "../lib/sanitize-rich-text";
import { alignCategoryPrices, formatMenuPrice, type SiteMenu } from "../lib/backstage/menus";
import { safeLinkUrl } from "../lib/safe-url";
import { uniqueMenuRoutes } from "../site/menu-routes";

interface Props {
  menu: SiteMenu;
  menuRoutes: Array<{ path: string; label: string; menu: SiteMenu }>;
  menuDirectoryPath?: string;
  isEmbedded?: boolean;
}

const { menu, menuRoutes, menuDirectoryPath, isEmbedded = false } = Astro.props;
const pdfUrl = safeLinkUrl(menu.pdfUrl);
const categoryAnchors = menu.categories.map((category, index) => ({
  id: `menu-category-${menu.id}-${index}`,
  title: category.title,
}));
const visibleMenuRoutes = uniqueMenuRoutes(menuRoutes, Astro.url.pathname);
---

<section class:list={["menu-page", isEmbedded && "menu-page--embedded"]} aria-labelledby={`menu-title-${menu.id}`}>
  <header class="menu-page__header">
    {isEmbedded
      ? <h2 class="menu-page__title" id={`menu-title-${menu.id}`}>{menu.title}</h2>
      : <h1 class="menu-page__title" id={`menu-title-${menu.id}`}>{menu.title}</h1>}
    {menu.subtitle && <p class="menu-page__subtitle">{menu.subtitle}</p>}
    {menuDirectoryPath && <a class="menu-page__location-link" href={menuDirectoryPath}>Menus by location</a>}
    {pdfUrl && <a class="menu-page__download" href={pdfUrl} target="_blank" rel="noopener noreferrer">Download Menu</a>}
  </header>

  {visibleMenuRoutes.length > 1 && (
    <nav class="menu-page__selector" aria-label="Choose a menu">
      {visibleMenuRoutes.map((route) => (
        <a href={route.path} aria-current={route.path === Astro.url.pathname ? "page" : undefined}>{route.label}</a>
      ))}
    </nav>
  )}

  {categoryAnchors.length > 1 && (
    <nav class="menu-page__category-nav" aria-label="Menu categories" data-menu-category-nav>
      {categoryAnchors.map((category) => <a href={`#${category.id}`}>{category.title}</a>)}
    </nav>
  )}

  <div class="menu-page__categories">
    {menu.categories.map((category, index) => (
      <section class="menu-category" id={categoryAnchors[index].id} aria-labelledby={`${categoryAnchors[index].id}-title`} style={`--category-columns: ${category.columns ?? 2}`}>
        <header class="menu-category__header">
          {isEmbedded
            ? <h3 class="menu-category__title" id={`${categoryAnchors[index].id}-title`}>{category.title}</h3>
            : <h2 class="menu-category__title" id={`${categoryAnchors[index].id}-title`}>{category.title}</h2>}
          {category.subtitle && <p class="menu-category__subtitle">{category.subtitle}</p>}
          {category.serves && <p class="menu-category__serves">Serves {category.serves}</p>}
          {category.description && <div class="menu-category__description" set:html={sanitizeRichText(category.description)} />}
        </header>
        <div
          class:list={["menu-category__pricing-scroll", (category.pricingColumns?.length ?? 0) > 0 && "menu-category__pricing-scroll--active"]}
          role={(category.pricingColumns?.length ?? 0) > 0 ? "region" : undefined}
          tabindex={(category.pricingColumns?.length ?? 0) > 0 ? 0 : undefined}
          aria-label={(category.pricingColumns?.length ?? 0) > 0 ? `Scrollable pricing for ${category.title}` : undefined}
        >
          <div
            class:list={["menu-category__items", (category.pricingColumns?.length ?? 0) > 0 && "menu-category__items--pricing"]}
            role={(category.pricingColumns?.length ?? 0) > 0 ? "table" : undefined}
            aria-label={(category.pricingColumns?.length ?? 0) > 0 ? `${category.title} prices` : undefined}
            style={(category.pricingColumns?.length ?? 0) > 0
              ? `--category-price-count: ${category.pricingColumns!.length}; --pricing-table-min-width: ${15 + category.pricingColumns!.length * 6.25}rem`
              : undefined}
          >
            {(category.pricingColumns?.length ?? 0) > 0 && (
              <div role="rowgroup">
                <div class="menu-category__pricing-row menu-category__pricing-header" role="row">
                  <div role="columnheader">Item</div>
                  {category.pricingColumns?.map((column) => <div role="columnheader">{column}</div>)}
                </div>
              </div>
            )}
            <div
              class:list={["menu-category__items-body", (category.pricingColumns?.length ?? 0) > 0 && "menu-category__items-body--pricing"]}
              role={(category.pricingColumns?.length ?? 0) > 0 ? "rowgroup" : undefined}
            >
              {category.items.map((item) => {
                const description = item.description ? sanitizeRichText(item.description) : "";
                const usesCategoryPricing = (category.pricingColumns?.length ?? 0) > 0;
                const alignedPrices = usesCategoryPricing
                  ? alignCategoryPrices(category.pricingColumns ?? [], item.hiddenPrice ? [] : item.prices)
                  : { columns: [], additional: [] };
                const multiPrice = !usesCategoryPricing && (item.priceType === "multiple" || item.prices.length > 1);
                const itemPrice = !item.hiddenPrice && !usesCategoryPricing && !multiPrice ? item.prices[0]?.value : null;
                const itemLevelPrices = usesCategoryPricing
                  ? alignedPrices.additional
                  : multiPrice ? item.prices : [];

                return (
                  <article
                    class:list={["menu-item", usesCategoryPricing && "menu-item--category-pricing", item.imageUrl && "menu-item--with-image"]}
                    role={usesCategoryPricing ? "row" : undefined}
                  >
                    <div class="menu-item__details" role={usesCategoryPricing ? "rowheader" : undefined}>
                      <div class="menu-item__content">
                        <div class="menu-item__topline">
                          {isEmbedded ? <h4 class="menu-item__title">{item.title}</h4> : <h3 class="menu-item__title">{item.title}</h3>}
                          {itemPrice && <span class="menu-item__leader" aria-hidden="true" />}
                          {itemPrice && item.prices[0]?.label && <span class="menu-item__price-label">{item.prices[0].label}</span>}
                          {itemPrice && <span class="menu-item__price">{formatMenuPrice(itemPrice)}</span>}
                        </div>
                        {item.postTitle && <p class="menu-item__post-title">{item.postTitle}</p>}
                        {item.subtitle && <p class="menu-item__subtitle">{item.subtitle}</p>}
                        {item.serves && <p class="menu-item__serves">Serves {item.serves}</p>}
                        {description && <div class="menu-item__description" set:html={description} />}
                        {item.dietaryTags.length > 0 && <p class="menu-item__dietary-tags">Dietary: {item.dietaryTags.join(", ")}</p>}
                        {itemLevelPrices.length > 0 && (
                          <dl class="menu-item__prices">
                            {itemLevelPrices.map((price) => (
                              <div>
                                {price.label && <dt>{price.label}</dt>}
                                <dd>{formatMenuPrice(price.value)}</dd>
                              </div>
                            ))}
                          </dl>
                        )}
                      </div>
                      {item.imageUrl && <img class="menu-item__image" src={item.imageUrl} alt={item.imageAlt || item.title} width={item.imageWidth ?? 400} height={item.imageHeight ?? 400} loading="lazy" decoding="async" />}
                    </div>
                    {alignedPrices.columns.map((price) => (
                      <div class="menu-item__category-price" role="cell" aria-label={price.value ? undefined : "No price listed"}>
                        {price.value ? formatMenuPrice(price.value) : ""}
                      </div>
                    ))}
                  </article>
                );
              })}
            </div>
          </div>
        </div>
        {category.afterDescription && <div class="menu-category__after" set:html={sanitizeRichText(category.afterDescription)} />}
      </section>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-menu-category-nav]").forEach((nav) => {
    const menu = nav.closest<HTMLElement>(".menu-page");
    if (!menu) return;

    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
    const categories = [...menu.querySelectorAll<HTMLElement>(".menu-category")];
    let current: HTMLAnchorElement | undefined;
    let frame = 0;
    let offset = 0;
    const gap = 12;

    const update = () => {
      frame = 0;
      const bar = nav.getBoundingClientRect();
      const readingLine = Math.max(bar.bottom, 0) + gap + 1;
      let index = 0;
      for (let i = 1; i < categories.length; i++) {
        if (categories[i].getBoundingClientRect().top > readingLine) break;
        index = i;
      }

      if (scrollY > 0 && document.documentElement.scrollHeight - innerHeight - scrollY <= 1) {
        const last = categories.at(-1)?.getBoundingClientRect();
        if (last && last.top < innerHeight && last.bottom > readingLine) index = categories.length - 1;
      }

      const active = links[index];
      if (!active || active === current) return;
      current?.removeAttribute("aria-current");
      active.setAttribute("aria-current", "location");
      current = active;

      // Reveal the current label without scrolling the page itself.
      const label = active.getBoundingClientRect();
      if (label.left < bar.left) nav.scrollBy({ left: label.left - bar.left, behavior: "instant" });
      else if (label.right > bar.right) nav.scrollBy({ left: label.right - bar.right, behavior: "instant" });
    };

    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    const measure = () => {
      const next = nav.offsetHeight + gap;
      if (next !== offset) {
        menu.style.setProperty("--menu-category-offset", `${next}px`);
        offset = next;
      }
      schedule();
    };

    const resize = new ResizeObserver(measure);
    resize.observe(nav);
    resize.observe(menu);
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("hashchange", schedule);
    measure();
  });
</script>

<style>
  .menu-page {
    width: min(calc(100% - var(--ui-page-gutter) - var(--ui-page-gutter)), var(--ui-container-width));
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) 0 3rem;
  }

  .menu-page--embedded {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .menu-page__header {
    display: flex;
    min-height: 2.25rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .menu-page__title {
    width: 100%;
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1.1;
    text-wrap: balance;
  }

  .menu-page--embedded .menu-page__title {
    font-size: 2rem;
  }

  @media (max-width: 680px) {
    .menu-page__title {
      font-size: 2.15rem;
    }
  }

  .menu-page__subtitle {
    margin: 0 auto 0 0;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .menu-page__location-link {
    color: var(--color-accent-strong);
    font-weight: 650;
    text-underline-offset: 0.2em;
  }

  .menu-page__download {
    flex: 0 0 auto;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .menu-page__download:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .menu-page__selector {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0 0 1.25rem;
  }

  .menu-page__selector a {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--ui-radius-button);
    background: var(--theme-color-surface);
    color: var(--theme-color-foreground);
    font-weight: 700;
    text-decoration: none;
  }

  .menu-page__selector a[aria-current="page"] {
    border-color: var(--theme-color-action);
    background: var(--theme-color-action);
    color: var(--theme-color-primary-foreground);
  }

  .menu-page__selector a:not([aria-current="page"]):hover {
    border-color: var(--theme-color-action);
  }

  .menu-page__category-nav {
    position: sticky;
    z-index: 1;
    top: 0;
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    overflow-x: auto;
    padding: 0.85rem 4px;
    border-block: 1px solid var(--color-line);
    background: var(--theme-color-background);
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
  }

  .menu-page__category-nav a {
    flex: 0 0 auto;
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    color: var(--color-ink);
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu-page__category-nav a[aria-current="location"],
  .menu-page__category-nav a:hover,
  .menu-page__category-nav a:focus-visible {
    border-color: var(--color-accent-strong);
  }

  .menu-page__categories {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .menu-page--embedded .menu-page__categories {
    gap: clamp(2rem, 4vw, 3rem);
    padding-top: 1.5rem;
  }

  .menu-category__header {
    max-width: 50rem;
    margin-bottom: 1.1rem;
  }

  .menu-category {
    min-width: 0;
  }

  .menu-page__category-nav + .menu-page__categories .menu-category {
    scroll-margin-top: var(--menu-category-offset, 4.5rem);
  }

  .menu-category__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    font-weight: 560;
    line-height: 1.1;
  }

  .menu-category h2::after {
    display: block;
    width: 2rem;
    height: 0.18rem;
    margin-top: 0.45rem;
    background: var(--color-accent-strong);
    content: "";
  }

  .menu-category__subtitle,
  .menu-category__serves,
  .menu-category__description,
  .menu-category__after {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .menu-category__subtitle {
    margin: 0.45rem 0 0;
    font-weight: 650;
  }

  .menu-category__serves,
  .menu-item__serves {
    margin: 0.35rem 0 0;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .menu-category__description {
    margin-top: 0.6rem;
  }

  .menu-category__description :global(p),
  .menu-category__after :global(p),
  .menu-item__description :global(p) {
    margin: 0;
  }

  .menu-category__items {
    display: grid;
    grid-template-columns: repeat(var(--category-columns), minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .menu-category__pricing-scroll {
    display: contents;
  }

  .menu-category__pricing-scroll--active {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .menu-category__pricing-scroll--active:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    outline-offset: 3px;
  }

  .menu-category__items--pricing {
    display: block;
    width: max(100%, var(--pricing-table-min-width));
  }

  .menu-category__items-body {
    display: contents;
  }

  .menu-category__items-body--pricing {
    display: grid;
    width: 100%;
  }

  .menu-category__pricing-row {
    display: grid;
    grid-template-columns: minmax(15rem, 2fr) repeat(var(--category-price-count), minmax(5.5rem, 1fr));
    column-gap: 0.75rem;
    width: 100%;
  }

  .menu-category__pricing-header {
    padding: 0 0.25rem 0.55rem;
    border-bottom: 2px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 750;
    text-align: center;
  }

  .menu-category__pricing-header [role="columnheader"]:first-child {
    text-align: left;
  }

  .menu-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    padding: 0.9rem 0;
  }

  .menu-item__image {
    grid-column: 2;
    grid-row: 1;
    width: 4.75rem;
    height: 4.75rem;
    object-fit: cover;
  }

  .menu-item__details {
    grid-column: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }

  .menu-item--with-image .menu-item__details {
    grid-template-columns: minmax(0, 1fr) 4.75rem;
    gap: 0.9rem;
  }

  .menu-item__content {
    grid-column: 1;
    min-width: 0;
  }

  .menu-item--category-pricing {
    grid-template-columns: minmax(15rem, 2fr) repeat(var(--category-price-count), minmax(5.5rem, 1fr));
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }

  .menu-item--category-pricing .menu-item__details,
  .menu-item__category-price {
    padding: 0.9rem 0;
  }

  .menu-item__category-price {
    display: grid;
    min-width: 0;
    align-content: center;
    justify-items: center;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    font-weight: 750;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .menu-item__topline {
    display: flex;
    min-width: 0;
    align-items: baseline;
    gap: 0.55rem;
  }

  .menu-item__title {
    flex: 0 1 auto;
    margin: 0;
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.4;
  }

  .menu-item__leader {
    min-width: 1rem;
    flex: 1;
    border-bottom: 1px dotted var(--color-muted);
    transform: translateY(-0.25rem);
  }

  .menu-item__price,
  .menu-item__prices dd {
    flex: 0 0 auto;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    font-weight: 750;
  }

  .menu-item__price-label {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: 0.76rem;
    white-space: nowrap;
  }

  .menu-item__subtitle {
    margin: 0.2rem 0 0;
    color: var(--color-accent-strong);
    font-size: 0.88rem;
    font-weight: 650;
  }

  .menu-item__post-title,
  .menu-item__dietary-tags {
    margin: 0.2rem 0 0;
    color: var(--color-muted);
    font-size: 0.78rem;
  }

  .menu-item__description {
    margin-top: 0.3rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .menu-item__prices {
    display: grid;
    gap: 0.25rem;
    margin: 0.65rem 0 0;
  }

  .menu-item__prices > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .menu-item__prices dt,
  .menu-item__prices dd {
    margin: 0;
  }

  .menu-item__prices dt:empty {
    display: none;
  }

  .menu-category__after {
    margin-top: 1rem;
  }

  @media (max-width: 760px) {
    .menu-page__header {
      min-height: 2rem;
    }

    .menu-category__items {
      grid-template-columns: minmax(0, 1fr);
    }

    .menu-page__category-nav {
      margin-inline: -0.25rem;
      padding-inline: 0.25rem;
    }

    .menu-item--with-image .menu-item__details {
      grid-template-columns: minmax(0, 1fr) 4rem;
      gap: 0.65rem;
    }

    .menu-item__image {
      width: 4rem;
      height: 4rem;
    }
  }
</style>
