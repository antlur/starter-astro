---
import Hero from "../blocks/hero/Hero.astro";
import ContactForm from "../blocks/contact-form/ContactForm.astro";
import CallToAction from "../blocks/call-to-action/CallToAction.astro";
import CardGrid from "../blocks/card-grid/CardGrid.astro";
import ImageBlock from "../blocks/image/ImageBlock.astro";
import ImageGallery from "../blocks/image-gallery/ImageGallery.astro";
import ImageLinkGrid from "../blocks/image-link-grid/ImageLinkGrid.astro";
import MenuBlock from "../blocks/menu/MenuBlock.astro";
import MediaWithText from "../blocks/media-with-text/MediaWithText.astro";
import RichText from "../blocks/rich-text/RichText.astro";
import UpcomingEvents from "../blocks/upcoming-events/UpcomingEvents.astro";
import InstagramFeed from "../blocks/instagram-feed/InstagramFeed.astro";
import VideoHero from "../blocks/video-hero/VideoHero.astro";
import type { HeadlessBlock } from "../lib/backstage/content";

interface Props {
  block: HeadlessBlock;
  isPrimary?: boolean;
}

const { block, isPrimary = false } = Astro.props;
const registry = {
  hero: Hero,
  "contact-form": ContactForm,
  "call-to-action": CallToAction,
  "card-grid": CardGrid,
  image: ImageBlock,
  "image-gallery": ImageGallery,
  "image-link-grid": ImageLinkGrid,
  "media-with-text": MediaWithText,
  menu: MenuBlock,
  "rich-text": RichText,
  "upcoming-events": UpcomingEvents,
  "instagram-feed": InstagramFeed,
  "video-hero": VideoHero,
} as const;

const Component = registry[block.type as keyof typeof registry];

if (!Component) {
  throw new Error("No local block renderer is registered for Backstage block type: " + block.type);
}
---

<Component block={block} isPrimary={isPrimary} />
