---
interface Props {
  measurementId: string;
}

const { measurementId } = Astro.props;
---

<script is:inline define:vars={{ measurementId }} data-google-analytics>
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
  window.gtag("js", new Date());
  window.gtag("config", measurementId, {
    allow_google_signals: false,
    allow_ad_personalization_signals: false,
  });
</script>
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>

<script>
  import { GAEvents } from "@antlur/backstage/constants/google-events";

  const { gtag } = window as Window & { gtag?: (command: "event", name: string, params: object) => void };
  if (gtag && document.querySelector("[data-google-analytics]")) {
    const track = (event: MouseEvent) => {
      if (event.defaultPrevented || !(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>("a[href]");
      if (!link) return;

      const name = link.dataset.gaEvent ?? (link.protocol === "tel:" ? GAEvents.CLICK_TO_CALL : null);
      if (name) gtag("event", name, JSON.parse(link.dataset.gaParams ?? "{}"));
    };

    document.addEventListener("click", track);
    document.addEventListener("auxclick", (event) => { if (event.button === 1) track(event); });
  }
</script>
