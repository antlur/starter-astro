---
import BlockRenderer from "./BlockRenderer.astro";
import PageLayoutRenderer from "./PageLayoutRenderer.astro";
import type { HeadlessPage } from "../lib/backstage/content";
import { primaryHeadingIndex } from "../lib/page-headings";

interface Props {
  page: HeadlessPage;
}

const { page } = Astro.props;
const primaryBlockIndex = primaryHeadingIndex(page.blocks);
---

<PageLayoutRenderer page={page}>
  {primaryBlockIndex === -1 && page.blocks.length > 0 && <h1 class="visually-hidden">{page.title}</h1>}
  {page.blocks.length === 0 && <h1 class="page-title">{page.title}</h1>}
  {page.blocks.map((block, index) => (
    <BlockRenderer block={block} isPrimary={index === primaryBlockIndex} />
  ))}
</PageLayoutRenderer>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-title {
    max-width: 74rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1.05;
  }
</style>
