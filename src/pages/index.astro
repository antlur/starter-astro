---
import PageContent from "../components/PageContent.astro";
import LocationHoursSection from "../components/LocationHoursSection.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getHomePage } from "../lib/backstage/content";
import { isPublicLocation } from "../lib/backstage/locations";
import { getSiteBuild } from "../site/build";

const { content, routePlan } = await getSiteBuild();
const page = getHomePage(content.pages);
const publicLocations = content.locations.filter(isPublicLocation);
const visitBlocks = routePlan.locationRoutes.some(({ location }) => isPublicLocation(location))
  ? page.blocks.filter(({ type }) => type === "locations") : [];
const hasDetailedVisitSection = visitBlocks.some(({ fields }) => fields.layout === "visit-panel");
const hasAdditionalVisitDetails = publicLocations.some((location) =>
  location.hours.length > 1 || (location.hourGroups?.length ?? 0) > 1 || location.specialHours?.length || location.mapEmbedUrl,
);
---

<SiteLayout page={page} site={content.site} pathname="/" navigation={routePlan.navigation} footerNavigation={routePlan.footerNavigation} routePaths={content.routePaths} alerts={content.alerts} locations={publicLocations} locationDirectoryPath={routePlan.locationIndexPaths[0]} showLocationHours={false}>
  <PageContent page={page} />
  {publicLocations.length === 1 && !hasDetailedVisitSection && (visitBlocks.length === 0 || hasAdditionalVisitDetails) && (
    <LocationHoursSection locations={publicLocations} />
  )}
</SiteLayout>
