---
import PageContent from "../components/PageContent.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteContent } from "../lib/backstage/content";
import { getPageForRoute, siteRoutes } from "../site/routes";

export const getStaticPaths = async () => {
  const content = await getSiteContent();

  return siteRoutes
    .filter((route) => route.path !== "/")
    .map((route) => ({
      params: { slug: route.path.replace(/^\/|\/$/g, "") },
      props: {
        page: getPageForRoute(content, route),
        site: content.site,
        pathname: route.path,
      },
    }));
};

const { page, site, pathname } = Astro.props;
---

<SiteLayout page={page} site={site} pathname={pathname}>
  <PageContent page={page} />
</SiteLayout>
