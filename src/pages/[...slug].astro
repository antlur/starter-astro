---
import PageContent from "../components/PageContent.astro";
import BlueprintRouteContent from "../components/BlueprintRouteContent.astro";
import EventPage from "../components/EventPage.astro";
import LocationPage from "../components/LocationPage.astro";
import LocationDirectoryPage from "../components/LocationDirectoryPage.astro";
import LocationContactLinks from "../components/LocationContactLinks.astro";
import MenuPage from "../components/MenuPage.astro";
import PressPage from "../components/PressPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { resolveBackstageRoute } from "../lib/backstage/content";
import { isPublicLocation } from "../lib/backstage/locations";
import { selectMenuForIndex } from "../lib/backstage/menus";
import { getSiteBuild, resolveGeneratedRouteSeo } from "../site/build";
import { locationRouteForPath, menuLocationScopeForRoute, menuRoutesForLocation, type SiteMenuRoute } from "../site/menu-routes";
import { locationServices } from "../site/location-choices";
import { assertStaticRoutesEmitted } from "../site/routes";
import { isRestaurantProfile } from "../site/profile";

export const getStaticPaths = async () => {
  const { content, routePlan, resolvedRoutes } = await getSiteBuild();
  const menuRoutes = routePlan.menuRoutes.filter(({ menu }) => menu.isPublished !== false);
  const locations = content.locations.filter(isPublicLocation);
  const locationRoutes = routePlan.locationRoutes.filter(({ location }) => isPublicLocation(location));
  const menuUsesVisitFooter = content.site.locationHoursFooter === "show" && locationRoutes.length > 0;
  const generatedSeoPaths = [
    ...menuRoutes.map(({ path }) => path),
    ...routePlan.menuIndexPaths,
    ...locationRoutes.map(({ path }) => path),
    ...routePlan.locationIndexPaths,
    ...routePlan.eventRoutes.map(({ path }) => path),
    ...routePlan.pressRoutes.map(({ path }) => path),
  ];
  const source = import.meta.env.BACKSTAGE_SOURCE;
  const resolver = source === "api" || source === "fixture" ? resolveBackstageRoute : undefined;
  const generatedRouteSeo = await resolveGeneratedRouteSeo(generatedSeoPaths, resolvedRoutes, resolver);
  const indexedMenuCandidates = [
    ...menuRoutes.map(({ menu }) => menu),
    ...content.menus.filter((menu) => menu.isPublished !== false
      && !menuRoutes.some(({ menu: routeMenu }) => routeMenu.id === menu.id)),
  ];
  const menuRouteForIndex = (path: string) => {
    const routeMeta = generatedRouteSeo.get(path);
    const resolverMenuId = routeMeta?.type === "menu" ? routeMeta.id : null;
    const locationRoute = locationRouteForPath(path, locationRoutes);
    const location = locationRoute?.location ?? (locations.length === 1 ? locations[0] : null);
    const menu = selectMenuForIndex(indexedMenuCandidates, resolverMenuId, location?.menuIds);

    if (!menu) return null;
    return menuRoutes.find(({ menu: routeMenu }) => routeMenu.id === menu.id)
      ?? { path, label: menu.title, menu };
  };
  const selectorRoutesFor = (path: string, route: SiteMenuRoute) => menuRoutesForLocation(
    menuRoutes,
    path,
    menuLocationScopeForRoute(path, route.menu.id, locations, locationRoutes, route.locationId),
  );

  const cmsPages = routePlan.cmsPages
    .filter(({ path }) => path !== "/")
    .map(({ path, page }) => ({
      params: { slug: path.replace(/^\/|\/$/g, "") },
      props: {
        page,
        ...(isRestaurantProfile() && path === "/contact/" && { locationRoutes }),
        site: content.site,
        locations,
        pathname: path,
        navigation: routePlan.navigation,
        footerNavigation: routePlan.footerNavigation,
        routePaths: content.routePaths,
        alerts: content.alerts,
      },
    }));

  const blueprintPages = routePlan.blueprintRoutes
    .filter((route) => route.path !== "/")
    .map((route) => ({
      params: { slug: route.path.replace(/^\/|\/$/g, "") },
      props: {
        route,
        site: content.site,
        locations,
        pathname: route.path,
        navigation: routePlan.navigation,
        footerNavigation: routePlan.footerNavigation,
        routePaths: content.routePaths,
        alerts: content.alerts,
      },
    }));

  const menuPages = menuRoutes.map((menuRoute) => ({
    params: { slug: menuRoute.path.replace(/^\/|\/$/g, "") },
    props: {
      menuRoute,
      menuRoutes: selectorRoutesFor(menuRoute.path, menuRoute),
      site: content.site,
      locations,
      pathname: menuRoute.path,
      routeSeo: generatedRouteSeo.get(menuRoute.path) ?? null,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const menuIndexPages = routePlan.menuIndexPaths.flatMap((path) => {
    const menuRoute = menuRouteForIndex(path);
    return menuRoute ? [{
      params: { slug: path.replace(/^\/+|\/+$/g, "") },
      props: {
        menuRoute,
        menuRoutes: selectorRoutesFor(path, menuRoute),
        site: content.site,
        locations,
        pathname: path,
        routeSeo: generatedRouteSeo.get(path) ?? null,
        navigation: routePlan.navigation,
        footerNavigation: routePlan.footerNavigation,
        routePaths: content.routePaths,
        alerts: content.alerts,
      },
    }] : [];
  });

  const eventPages = routePlan.eventRoutes.map((eventRoute) => ({
    params: { slug: eventRoute.path.replace(/^\/+|\/+$/g, "") },
    props: {
      eventRoute,
      eventIndexPath: routePlan.eventsIndexPath,
      events: content.events,
      locations,
      site: content.site,
      pathname: eventRoute.path,
      routeSeo: generatedRouteSeo.get(eventRoute.path) ?? null,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const locationPages = locationRoutes.map((locationRoute) => ({
    params: { slug: locationRoute.path.replace(/^\/+|\/+$/g, "") },
    props: {
      locationRoute,
      menuRoutes,
      locationRoutes,
      site: content.site,
      locations,
      pathname: locationRoute.path,
      routeSeo: generatedRouteSeo.get(locationRoute.path) ?? null,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const locationIndexPages = routePlan.locationIndexPaths.map((path) => ({
    params: { slug: path.replace(/^\/+|\/+$/g, "") },
    props: {
      locationIndexPath: path,
      locationRoutes,
      menuRoutes: isRestaurantProfile() ? menuRoutes : [],
      site: content.site,
      locations,
      pathname: path,
      routeSeo: generatedRouteSeo.get(path) ?? null,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const locationChooserPages = routePlan.locationChooserRoutes.map(({ path, purpose }) => ({
    params: { slug: path.replace(/^\/+|\/+$/g, "") },
    props: {
      locationChooser: purpose,
      locationRoutes,
      menuRoutes,
      site: content.site,
      locations,
      pathname: path,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const pressPages = routePlan.pressRoutes.map((pressRoute) => ({
    params: { slug: pressRoute.path.replace(/^\/|\/$/g, "") },
    props: {
      pressRoute,
      pressIndexPath: routePlan.pressRoutes.find(({ kind }) => kind === "index")?.path ?? null,
      pressReleases: content.pressReleases,
      site: content.site,
      locations,
      pathname: pressRoute.path,
      routeSeo: generatedRouteSeo.get(pressRoute.path) ?? null,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const menuSectionPaths = routePlan.locationChooserRoutes.filter(({ purpose }) => purpose === "menu").map(({ path }) => path);
  const menuDirectoryPath = menuSectionPaths[0];
  const staticPages = [
    ...cmsPages,
    ...blueprintPages,
    ...menuPages,
    ...menuIndexPages,
    ...eventPages,
    ...locationPages,
    ...locationIndexPages,
    ...locationChooserPages,
    ...pressPages,
  ].map(({ params, props }) => {
    const menu = "menuRoute" in props ? props.menuRoute : undefined;
    const menuLocationId = menu?.locationId;
    const currentLocation = menuLocationId
      ? locationRoutes.find(({ location }) => location.id === menuLocationId)?.location
      : locationRouteForPath(props.pathname, locationRoutes)?.location;
    const showMenuVisitAction = menu && isRestaurantProfile() && !menuUsesVisitFooter;
    const visitPath = showMenuVisitAction
      ? menuLocationScopeForRoute(props.pathname, menu.menu.id, locations, locationRoutes, menuLocationId)?.path
      : null;
    const locationDirectoryPath = routePlan.locationIndexPaths[0];
    const menuVisitLink = visitPath ? { href: visitPath, label: "Hours & location" }
      : showMenuVisitAction && locationDirectoryPath
        ? { href: locationDirectoryPath, label: "Choose a location" }
        : undefined;
    const generatedLocationPage = "locationRoute" in props || "locationIndexPath" in props || "locationChooser" in props;
    const locationScopedMenu = Boolean(menu && currentLocation);
    return {
      params,
      props: {
        ...props,
        currentLocation,
        generatedLocationPage,
        locationScopedMenu,
        menuDirectoryPath,
        menuVisitLink,
        menuSectionPaths: menu || ("locationChooser" in props && props.locationChooser === "menu") ? menuSectionPaths : [],
        locationDirectoryPath,
      },
    };
  });
  assertStaticRoutesEmitted(routePlan, staticPages.map(({ props }) => props.pathname), import.meta.env.SITE_INDEXABLE === "true");

  return staticPages;
};

const { page, route, routeSeo, menuRoute, menuRoutes, menuDirectoryPath, menuVisitLink, menuSectionPaths, eventRoute, eventIndexPath, events, locationRoute, locationIndexPath, locationChooser, locationRoutes, currentLocation, locationDirectoryPath, generatedLocationPage, locationScopedMenu, pressRoute, pressIndexPath, pressReleases, site, pathname, navigation, footerNavigation, routePaths, alerts, locations } = Astro.props;
const chooserTitle = locationChooser === "menu" ? "Menus by location" : locationChooser ? locationServices[locationChooser].label : null;
const pageTitle = routeSeo?.title ?? chooserTitle ?? (pressRoute?.kind === "detail"
  ? pressRoute.release.title
  : pressRoute?.kind === "index"
    ? "Press"
    : eventRoute?.kind === "detail"
      ? eventRoute.event.title
        : eventRoute?.kind === "index"
          ? "Events"
        : locationIndexPath
          ? "Our locations"
        : locationRoute
          ? `Visit ${locationRoute.location.name}`
          : null);
const pageDescription = routeSeo?.description ?? (pressRoute?.kind === "detail"
  ? pressRoute.release.excerpt ?? pressRoute.release.title
      : eventRoute?.kind === "detail"
        ? eventRoute.event.shortDescription ?? eventRoute.event.title
    : locationIndexPath
      ? "Find a location, get directions, and plan your visit."
    : locationRoute
      ? locationRoute.location.description
      : null);
const pageImage = pressRoute?.kind === "detail"
  ? pressRoute.release.imageUrl
  : eventRoute?.kind === "detail"
    ? eventRoute.event.imageUrl
    : locationRoute
      ? locationRoute.location.imageUrl
      : null;
const contentType = pressRoute?.kind === "detail" || eventRoute?.kind === "detail" ? "article" : "website";
---

<SiteLayout page={page} pageTitle={route?.seoTitle ?? routeSeo?.title ?? route?.title ?? menuRoute?.menu.title ?? pageTitle} pageDescription={route?.seoDescription ?? routeSeo?.description ?? menuRoute?.menu.subtitle ?? pageDescription} pageImage={pageImage} contentType={contentType} site={site} pathname={pathname} navigation={navigation} footerNavigation={footerNavigation} routePaths={routePaths} alerts={alerts} locations={locations} currentLocation={currentLocation} locationDirectoryPath={locationDirectoryPath} showLocationHours={!locationRoute} generatedLocationPage={generatedLocationPage} locationScopedMenu={locationScopedMenu} menuSectionPaths={menuSectionPaths}>
  {page
    ? <><PageContent page={page} />{locationRoutes && <LocationContactLinks routes={locationRoutes} />}</>
    : route
      ? <BlueprintRouteContent route={route} />
      : menuRoute
        ? <MenuPage menu={menuRoute.menu} menuRoutes={menuRoutes} menuDirectoryPath={menuDirectoryPath} visitLink={menuVisitLink} />
        : eventRoute
          ? <EventPage kind={eventRoute.kind} event={eventRoute.kind === "detail" ? eventRoute.event : undefined} events={events} locations={locations} indexPath={eventIndexPath} />
        : locationIndexPath || locationChooser
          ? <LocationDirectoryPage locations={locationRoutes} purpose={locationChooser} menuRoutes={menuRoutes} />
        : locationRoute
          ? <LocationPage location={locationRoute.location} routePath={locationRoute.path} menuRoutes={menuRoutes} locationRoutes={locationRoutes ?? []} />
            : pressRoute && <PressPage kind={pressRoute.kind} release={pressRoute.kind === "detail" ? pressRoute.release : undefined} releases={pressReleases} indexPath={pressIndexPath} />}
</SiteLayout>
