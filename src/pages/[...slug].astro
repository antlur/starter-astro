---
import PageContent from "../components/PageContent.astro";
import BlueprintRouteContent from "../components/BlueprintRouteContent.astro";
import EventPage from "../components/EventPage.astro";
import LocationPage from "../components/LocationPage.astro";
import LocationDirectoryPage from "../components/LocationDirectoryPage.astro";
import MenuPage from "../components/MenuPage.astro";
import PressPage from "../components/PressPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteBuild } from "../site/build";

export const getStaticPaths = async () => {
  const { content, routePlan } = await getSiteBuild();

  const cmsPages = routePlan.cmsPages
    .filter(({ path }) => path !== "/")
    .map(({ path, page }) => ({
      params: { slug: path.replace(/^\/|\/$/g, "") },
      props: {
        page,
        site: content.site,
        locations: content.locations,
        pathname: path,
        navigation: routePlan.navigation,
        footerNavigation: routePlan.footerNavigation,
        routePaths: content.routePaths,
        alerts: content.alerts,
      },
    }));

  const blueprintPages = routePlan.blueprintRoutes
    .filter((route) => route.path !== "/")
    .map((route) => ({
      params: { slug: route.path.replace(/^\/|\/$/g, "") },
      props: {
        route,
        site: content.site,
        locations: content.locations,
        pathname: route.path,
        navigation: routePlan.navigation,
        footerNavigation: routePlan.footerNavigation,
        routePaths: content.routePaths,
        alerts: content.alerts,
      },
    }));

  const menuPages = routePlan.menuRoutes.map((menuRoute) => ({
    params: { slug: menuRoute.path.replace(/^\/|\/$/g, "") },
    props: {
      menuRoute,
      menuRoutes: routePlan.menuRoutes,
      site: content.site,
      locations: content.locations,
      pathname: menuRoute.path,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const menuIndexPages = routePlan.menuIndexPaths.flatMap((path) => {
    const menuRoute = routePlan.menuRoutes[0];
    return menuRoute ? [{
      params: { slug: path.replace(/^\/+|\/+$/g, "") },
      props: {
        menuRoute,
        menuRoutes: routePlan.menuRoutes,
        site: content.site,
        locations: content.locations,
        pathname: path,
        navigation: routePlan.navigation,
        footerNavigation: routePlan.footerNavigation,
        routePaths: content.routePaths,
        alerts: content.alerts,
      },
    }] : [];
  });

  const eventPages = routePlan.eventRoutes.map((eventRoute) => ({
    params: { slug: eventRoute.path.replace(/^\/+|\/+$/g, "") },
    props: {
      eventRoute,
      eventIndexPath: routePlan.eventRoutes.find(({ kind }) => kind === "index")?.path ?? null,
      events: content.events,
      locations: content.locations,
      site: content.site,
      pathname: eventRoute.path,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const locationPages = routePlan.locationRoutes.map((locationRoute) => ({
    params: { slug: locationRoute.path.replace(/^\/+|\/+$/g, "") },
    props: {
      locationRoute,
      menuRoutes: routePlan.menuRoutes,
      site: content.site,
      locations: content.locations,
      pathname: locationRoute.path,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const locationIndexPages = routePlan.locationIndexPaths.map((path) => ({
    params: { slug: path.replace(/^\/+|\/+$/g, "") },
    props: {
      locationIndexPath: path,
      locationRoutes: routePlan.locationRoutes,
      site: content.site,
      locations: content.locations,
      pathname: path,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  const pressPages = routePlan.pressRoutes.map((pressRoute) => ({
    params: { slug: pressRoute.path.replace(/^\/|\/$/g, "") },
    props: {
      pressRoute,
      pressIndexPath: routePlan.pressRoutes.find(({ kind }) => kind === "index")?.path ?? null,
      pressReleases: content.pressReleases,
      site: content.site,
      locations: content.locations,
      pathname: pressRoute.path,
      navigation: routePlan.navigation,
      footerNavigation: routePlan.footerNavigation,
      routePaths: content.routePaths,
      alerts: content.alerts,
    },
  }));

  return [...cmsPages, ...blueprintPages, ...menuPages, ...menuIndexPages, ...eventPages, ...locationPages, ...locationIndexPages, ...pressPages];
};

const { page, route, menuRoute, menuRoutes, eventRoute, eventIndexPath, events, locationRoute, locationIndexPath, locationRoutes, pressRoute, pressIndexPath, pressReleases, site, pathname, navigation, footerNavigation, routePaths, alerts, locations } = Astro.props;
const pageTitle = pressRoute?.kind === "detail"
  ? pressRoute.release.title
  : pressRoute?.kind === "index"
    ? "Press"
    : eventRoute?.kind === "detail"
      ? eventRoute.event.title
        : eventRoute?.kind === "index"
          ? "Events"
        : locationIndexPath
          ? "Our locations"
        : locationRoute
          ? `Visit ${locationRoute.location.name}`
          : null;
const pageDescription = pressRoute?.kind === "detail"
  ? pressRoute.release.excerpt ?? pressRoute.release.title
      : eventRoute?.kind === "detail"
        ? eventRoute.event.shortDescription ?? eventRoute.event.title
    : locationIndexPath
      ? "Find a location, get directions, and plan your visit."
    : locationRoute
      ? locationRoute.location.description
      : null;
const pageImage = pressRoute?.kind === "detail"
  ? pressRoute.release.imageUrl
  : eventRoute?.kind === "detail"
    ? eventRoute.event.imageUrl
    : locationRoute
      ? locationRoute.location.imageUrl
      : null;
const contentType = pressRoute?.kind === "detail" || eventRoute?.kind === "detail" ? "article" : "website";
---

<SiteLayout page={page} pageTitle={route?.seoTitle ?? route?.title ?? menuRoute?.menu.title ?? pageTitle} pageDescription={route?.seoDescription ?? menuRoute?.menu.subtitle ?? pageDescription} pageImage={pageImage} contentType={contentType} site={site} pathname={pathname} navigation={navigation} footerNavigation={footerNavigation} routePaths={routePaths} alerts={alerts} locations={locations} showLocationHours={!locationRoute}>
  {page
    ? <PageContent page={page} />
    : route
      ? <BlueprintRouteContent route={route} />
      : menuRoute
        ? <MenuPage menu={menuRoute.menu} menuRoutes={menuRoutes} />
        : eventRoute
          ? <EventPage kind={eventRoute.kind} event={eventRoute.kind === "detail" ? eventRoute.event : undefined} events={events} locations={locations} indexPath={eventIndexPath} />
        : locationIndexPath
          ? <LocationDirectoryPage locations={locationRoutes} />
        : locationRoute
          ? <LocationPage location={locationRoute.location} menuRoutes={menuRoutes.map(({ path, label }) => ({ path, label }))} />
            : pressRoute && <PressPage kind={pressRoute.kind} release={pressRoute.kind === "detail" ? pressRoute.release : undefined} releases={pressReleases} indexPath={pressIndexPath} />}
</SiteLayout>
