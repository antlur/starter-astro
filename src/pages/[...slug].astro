---
import PageContent from "../components/PageContent.astro";
import BlueprintRouteContent from "../components/BlueprintRouteContent.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteBuild } from "../site/build";

export const getStaticPaths = async () => {
  const { content, routePlan } = await getSiteBuild();

  const cmsPages = routePlan.cmsPages
    .filter(({ path }) => path !== "/")
    .map(({ path, page }) => ({
      params: { slug: path.replace(/^\/|\/$/g, "") },
      props: {
        page,
        site: content.site,
        pathname: path,
        navigation: routePlan.navigation,
      },
    }));

  const blueprintPages = routePlan.blueprintRoutes
    .filter((route) => route.path !== "/")
    .map((route) => ({
      params: { slug: route.path.replace(/^\/|\/$/g, "") },
      props: {
        route,
        site: content.site,
        pathname: route.path,
        navigation: routePlan.navigation,
      },
    }));

  return [...cmsPages, ...blueprintPages];
};

const { page, route, site, pathname, navigation } = Astro.props;
---

<SiteLayout page={page} pageTitle={route?.seoTitle ?? route?.title} pageDescription={route?.seoDescription} site={site} pathname={pathname} navigation={navigation}>
  {page
    ? <PageContent page={page} />
    : route && <BlueprintRouteContent route={route} />}
</SiteLayout>
